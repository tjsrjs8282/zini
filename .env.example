# 문의 폼 전송 주소 (Formspree 등 JSON POST를 받는 서비스).
# 비워 두면 데모 모드 — 실제로 전송하지 않고 "데모라서 전송되지 않았어요" 안내만 보여 줍니다.
PUBLIC_CONTACT_ENDPOINT=

# 배포 주소 — 기본값은 GitHub Pages(https://tjsrjs8282.github.io + /zini),
# Vercel 빌드에서는 자동으로 Vercel 주소 + 루트(/). 아래 값을 넣으면 항상 이 값이 우선합니다.
# SITE_URL=https://example.com
# BASE_PATH=/
