---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CharacterSeries from '../components/sections/CharacterSeries.astro';
import CondomLineup from '../components/sections/CondomLineup.astro';
import ProductCarousel from '../components/sections/ProductCarousel.astro';
import Recommend from '../components/sections/Recommend.astro';
import Zigzag from '../components/ui/Zigzag.astro';
import ziniCondoms from '../assets/svg/ziniCondom2.svg';
import { img } from '../lib/images';

const appeal = [
  {
    title: '아시아인 사이즈에 맞춘, 아시아인을 위한 <em>맞춤형 콘돔!</em>',
    image: 'condom_content1.jpg',
    alt: '아시아인 사이즈에 맞춘 콘돔',
    text: '아시아인의, 아시아인에 의한, 아시아인을 위한, bururu CONDOMS의 대단한 도전! 드디어 아시아인 사이즈에 맞는 <em>맞춤형 콘돔 탄생!</em>',
    half: true,
  },
  {
    title: '착용 시 맨살에 느껴지는 <em class="m-db">놀라운 밀착력!</em>',
    image: 'condom_content2.jpg',
    alt: '피부에 밀착되는 콘돔',
    text: '착용 시 부드럽게 밀착되어 남성과 여성 모두 이질감을 느끼지 않으며, 이탈방지 효과와 함께 편안하고 만족스러운 핏감을 선사해 드립니다.',
    half: true,
  },
  {
    title: '놀랄만큼 뛰어난 <em>신축성</em>과 <em>탄력성</em>',
    image: 'condom_content3.png',
    alt: '신축성과 탄력성이 뛰어난 콘돔',
    text: '놀라운 탄력성으로 착용 시 부담을 주지 않으며, 강한 마찰과 외압에도 걱정없이 안전하게 사용하실 수 있습니다.',
  },
  {
    title: '<em>두께</em>는 낮추고, <em>투명도</em>는 높이고!',
    image: 'condom_content5.jpg',
    alt: '얇고 투명한 콘돔',
    text: '얇은 두께와 투명감으로 시각적인 느낌과 실제 착용감을 동시에 만족시켜드립니다.',
  },
];
---

<BaseLayout
  current="condom"
  title="콘돔"
  description="아시아인 사이즈에 맞춘 ZINI 캐릭터 콘돔 6종 — 오리지널, 젤, 강쇠, 콤보, 스키니, 닌자 콘돔을 소개합니다."
>
  <h1 class="visually-hidden">ZINI 콘돔</h1>

  <section class="condom-top">
    <div class="container text-center">
      <Image src={ziniCondoms} alt="ZINI CONDOMS" loading="eager" />
      <div class="condom-mascot">
        <Image src={img('condomMainCh.png')} alt="" width={400} loading="eager" />
      </div>
    </div>
    <Zigzag edge="bottom" point="down" color="#f9a81a" />
  </section>

  <section class="condom-middle bg-white">
    <div class="container text-center">
      <p class="kicker">명랑 안전제일!</p>
      <h2>명랑 전! 안전모 착용 준수</h2>
      <div class="row mt-3">
        {[0, 1, 2].map((i) => (
          <div class:list={[i === 1 ? 'col-12 col-md-4' : 'd-none d-md-block col-md-4']}>
            <Image
              src={img('condom_img1.png')}
              alt={i === 1 ? '안전모를 쓴 콘돔 캐릭터' : ''}
              width={226}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="condom-bottom mb-5">
    <Zigzag edge="top" point="up" color="var(--c-amber)" />
    <div class="container">
      <Image
        class="w-100 h-auto"
        src={img('condom_mainBottom.jpg')}
        alt="ZINI 콘돔 캐릭터들"
        widths={[540, 800, 1000]}
        sizes="(min-width: 1200px) 1110px, 100vw"
      />
    </div>
    <Zigzag edge="bottom" point="down" color="var(--c-amber)" />
  </section>

  <section class="condom-appeal" aria-labelledby="condom-appeal-title">
    <div class="container text-center bg-white shadow-card">
      <div class="row mb-4">
        <div class="col-12 product mb-3">
          <h2 id="condom-appeal-title">CONDOMS APPEAL</h2>
        </div>
      </div>
      <div class="row">
        {appeal.map((item) => (
          <div class:list={['col-12', 'pt-3', 'mb-4', 'shadow-card', { 'col-md-6': item.half }]}>
            <h3 set:html={item.title} />
            <Image
              class="w-100 h-auto mb-2"
              src={img(item.image)}
              alt={item.alt}
              widths={item.half ? [450] : [600, 920]}
              sizes={
                item.half ? '(min-width: 768px) 450px, 100vw' : '(min-width: 1200px) 920px, 100vw'
              }
            />
            <p class="my-3" set:html={item.text} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="condom-brand mb-5">
    <div class="container bg-white text-center mb-5 shadow-card">
      <div class="row">
        <div class="col-12 mb-5 brand-banner">
          <Image
            class="w-100 h-auto"
            src={img('condom_img1.jpg')}
            alt="ZINI 콘돔 캐릭터 배너"
            widths={[698]}
            sizes="(min-width: 768px) 698px, 100vw"
          />
          <p class="brand-copy">
            명랑전문 주식회사 (주)엠에스하모니에서 만든
            <span>
              <span class="hl">믿을 수 있는 콘돔!</span>
            </span>
            <span>
              <span class="hl">안전성과 착용감</span>을 모두 만족시켜주는
            </span>
            <span>
              <span class="hl">ZINI CONDOMS</span>
            </span>
          </p>
        </div>
        <div class="col-12 col-md-4">
          <Image class="mb-2" src={img('condom_logo1.jpg')} alt="SMART ON TYPE 로고" width={116} />
          <p>
            ZINI CONDOMS 만의 <span>인체공학적 간편착용 솔루션</span>
            <span class="hl">SMART ON TYPE</span>
          </p>
        </div>
        <div class="col-12 col-md-4">
          <Image class="mb-2" src={img('condom_logo2.jpg')} alt="KGMP 인증 로고" width={116} />
          <p>
            한국 우수 의약품 제조 및<span>품질관리 기준을 만족하는</span>
            <span class="hl">KGMP 인증 획득</span>
          </p>
        </div>
        <div class="col-12 col-md-4">
          <Image class="mb-2" src={img('condom_logo3.jpg')} alt="품질 인증 마크" width={129} />
        </div>
        <div class="col-12 py-3">
          <Image
            class="w-100 h-auto"
            src={img('condom_img2.jpg')}
            alt="ZINI 콘돔 패키지 라인업"
            widths={[698]}
            sizes="(min-width: 768px) 698px, 100vw"
          />
        </div>
      </div>
    </div>
  </section>

  <CharacterSeries tight />
  <CondomLineup linked={false} />
  <ProductCarousel />
  <Recommend />
</BaseLayout>

<style>
  .condom-top {
    position: relative;
    height: 340px;
    padding: 2rem 0;
    background: url('../assets/svg/condom_topBack.svg');
  }
  .condom-mascot {
    position: absolute;
    bottom: -200px;
    left: 50%;
    z-index: 2;
    width: 400px;
    max-width: 90vw;
    transform: translateX(-50%);
  }
  .condom-mascot img {
    width: 100%;
    height: auto;
  }

  .condom-middle {
    height: 800px;
    padding: 4rem 0;
    background-image: url('../assets/svg/condom_back.svg');
  }
  .condom-middle .container {
    margin-top: 150px;
  }
  .condom-middle .kicker {
    font-size: 1.6rem;
    font-weight: 700;
  }
  .condom-middle h2 {
    font-size: 2.4rem;
    font-weight: 700;
  }
  .condom-middle img {
    max-width: 100%;
    height: auto;
  }

  .condom-bottom {
    position: relative;
    padding: 4rem 0;
    background: var(--c-amber);
  }

  .condom-appeal {
    position: relative;
    z-index: 1;
    padding: 1rem 0;
  }
  .condom-appeal h3 {
    margin-bottom: 0.5rem;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.2;
  }
  .condom-appeal p {
    font-weight: 700;
    color: #444;
  }
  .condom-appeal :global(em) {
    display: inline-block;
    font-style: normal;
    color: #d53036;
  }

  .brand-banner {
    position: relative;
  }
  .brand-copy {
    padding-top: 1rem;
    font-size: 1.1rem;
  }
  @media (min-width: 992px) {
    .brand-copy {
      position: absolute;
      top: 50%;
      left: 50%;
      padding: 0;
      font-size: 1.3rem;
      transform: translate(-50%, -50%);
    }
  }

  @media (max-width: 767px) {
    .condom-appeal h3 {
      font-size: 1.3rem;
    }
    .condom-appeal p {
      font-size: 0.9rem;
    }
  }
</style>
