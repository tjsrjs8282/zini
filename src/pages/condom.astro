---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import CondomCard from '../components/sections/CondomCard.astro';
import FeatureCards from '../components/sections/FeatureCards.astro';
import type { Feature } from '../components/sections/FeatureCards.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import Icon from '../components/ui/Icon.astro';
import Img from '../components/ui/Img.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import Wordmark from '../components/ui/Wordmark.astro';
import { condoms } from '../data/products';
import pattern from '../assets/svg/condom_topBack.svg';

const appeal: Feature[] = [
  {
    title: '아시아인을 위한 <em>맞춤 사이즈</em>',
    text: '아시아인의, 아시아인에 의한, 아시아인을 위한 콘돔. 아시아인 체형에 맞춰 설계해 헐겁거나 조이지 않아요.',
    image: 'condom_content1.jpg',
    alt: 'SAFE와 JELL 캐릭터 콘돔 패키지',
  },
  {
    title: '맨살 같은 <em>밀착력</em>',
    text: '착용하면 부드럽게 밀착되어 남녀 모두 이질감이 적고, 잘 빠지지 않아 편안하고 만족스러운 핏을 선사해요.',
    image: 'condom_content2.jpg',
    alt: '피부에 꼭 맞게 밀착된 콘돔',
  },
  {
    title: '놀랄 만큼 뛰어난 <em>신축성</em>과 <em>탄력</em>',
    text: '쭉 늘려도 쉽게 찢어지지 않아요. 착용감은 부담 없이, 강한 마찰과 외압에도 걱정 없이 쓸 수 있어요.',
    image: 'condom_content3.png',
    alt: '양손으로 길게 늘려도 찢어지지 않는 콘돔',
    span: 'full',
  },
  {
    title: '두께는 낮추고, <em>투명도</em>는 높이고',
    text: '용기에 씌워도 글자가 그대로 비칠 만큼 얇고 투명해요. 보는 느낌과 실제 착용감을 함께 챙겼어요.',
    image: 'condom_content5.jpg',
    alt: '용기 위에 씌운 콘돔 너머로 제품 글자가 선명하게 비치는 착용 테스트',
    span: 'full',
  },
];

const trust = [
  {
    image: 'condom_logo1.jpg',
    title: 'SMART ON TYPE',
    text: 'ZINI만의 인체공학적 간편 착용 솔루션',
  },
  {
    image: 'condom_logo2.jpg',
    title: 'KGMP 인증',
    text: '한국 우수 의약품 제조 및 품질관리 기준 충족',
  },
  {
    image: 'condom_logo3.jpg',
    title: '품질 적합 인증',
    text: '의료기기 제조 및 품질관리 기준 적합 인정서',
  },
];
---

<BaseLayout
  current="condom"
  title="캐릭터 콘돔"
  themeColor="#f9a81a"
  description="아시아인 사이즈에 맞춘 ZINI 캐릭터 콘돔 6종 — SAFE, JELL, KANGSOE, COMBO, SKINNY, NINJA를 소개합니다."
>
  <PageHero
    class="condom-hero"
    eyebrow="ZINI Condoms"
    title="명랑 전!<br />안전모 착용 준수."
    lead="아시아인 사이즈에 맞춘 캐릭터 콘돔 6종. 책임질 수 있는 사랑을 위한, 안전제일 솔루션이에요."
    tone="#f9a81a"
    pattern={pattern.src}
  >
    <div class="page-hero__actions" slot="actions">
      <a class="btn btn--ink" href="#lineup">
        라인업 보기 <Icon name="arrow-down" />
      </a>
    </div>
    <div class="condom-hero__visual" slot="visual">
      <Wordmark class="condom-hero__word" condoms label="ZINI CONDOMS" />
      <div class="condom-hero__mascot">
        <Img
          name="condomMainCh.png"
          alt="안전모를 쓴 SAFE 캐릭터"
          width={415}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </PageHero>

  <section class="section" aria-labelledby="appeal-title">
    <div class="container">
      <SectionHead
        eyebrow="Condoms Appeal"
        id="appeal-title"
        title="귀여운 얼굴,<br />진지한 안전."
        lead="캐릭터는 명랑하지만 품질은 타협하지 않아요. ZINI 콘돔이 지키는 네 가지."
      />
      <FeatureCards class="appeal" items={appeal} />
    </div>
  </section>

  <section class="lineup section" id="lineup" aria-labelledby="lineup-title">
    <div class="container">
      <SectionHead
        eyebrow="Condoms Line Up"
        id="lineup-title"
        title="여섯 캐릭터 라인업"
        lead="모두 10개입 3,000원. 오늘 기분에 맞는 캐릭터를 골라 보세요."
      />
      <ul class="lineup__grid">
        {condoms.map((c, i) => (
          <li data-reveal style={`--i: ${i % 3}`}>
            <CondomCard condom={c} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="made section on-dark" aria-labelledby="made-title">
    <div class="container made__grid">
      <div>
        <SectionHead
          eyebrow="Made by MS Harmony"
          id="made-title"
          title="믿을 수 있는 공장에서<br />직접 만들어요."
          lead="명랑전문 주식회사 엠에스하모니가 직접 만든 콘돔이에요. 안전성과 착용감, 두 가지를 모두 만족시키는 게 목표예요."
        />
        <ul class="trust">
          {trust.map((t, i) => (
            <li class="trust__item" data-reveal style={`--i: ${i}`}>
              <span class="trust__logo">
                <Img name={t.image} alt="" width={129} />
              </span>
              <span>
                <strong>{t.title}</strong>
                <span>{t.text}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>
      <figure class="made__photo" data-reveal>
        <Img
          name="condom_img2.jpg"
          alt="엠에스하모니 공장 외관과 콘돔 생산 설비"
          widths={[480, 698]}
          sizes="(min-width: 960px) 560px, 92vw"
        />
        <figcaption>엠에스하모니 생산 공장과 콘돔 성형 설비</figcaption>
      </figure>
    </div>
  </section>

  <section class="pack section" aria-labelledby="pack-title">
    <div class="container">
      <figure class="pack__banner" data-reveal>
        <Img
          name="condom_mainBottom.jpg"
          alt="10개입과 3개입 캐릭터 콘돔 패키지 — 책임완수를 위한 안전제일 솔루션"
          widths={[640, 1000]}
          sizes="(min-width: 1080px) 760px, 92vw"
        />
      </figure>
      <div class="pack__copy">
        <SectionHead
          eyebrow="10 pcs · 3 pcs"
          id="pack-title"
          title="책임지는 사랑이<br />진짜 사랑!"
          lead="넉넉한 10개입과 가볍게 챙기는 3개입. 노골적이지 않은 디자인이라 가방에 넣어도 부담 없어요."
        />
      </div>
    </div>
  </section>

  <CtaBand
    title="오늘은 어떤 캐릭터로<br />할까요?"
    text="ZINI 캐릭터 콘돔 6종은 공식몰 부르르닷컴에서 만날 수 있어요."
  />
</BaseLayout>

<style>
  .condom-hero__visual {
    display: grid;
    justify-items: center;
    gap: 8px;
    width: min(100%, 460px);
  }
  :global(.condom-hero__word) {
    width: min(78%, 340px);
    color: var(--ink);
  }
  .condom-hero__mascot {
    width: min(86%, 380px);
    animation: mascot 4s ease-in-out infinite;
  }
  .condom-hero__mascot :global(img) {
    width: 100%;
    filter: drop-shadow(8px 8px 0 var(--ink));
  }
  @keyframes mascot {
    0%,
    100% {
      transform: translateY(0) rotate(-2deg);
    }
    50% {
      transform: translateY(-10px) rotate(2deg);
    }
  }

  .appeal {
    margin-top: clamp(40px, 5vw, 64px);
  }

  .lineup {
    background: var(--cream);
  }
  .lineup__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-top: clamp(40px, 5vw, 64px);
  }

  .made__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(40px, 6vw, 96px);
  }
  .trust {
    display: grid;
    gap: 12px;
    margin-top: 36px;
  }
  .trust__item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 12px 18px 12px 12px;
    background: rgb(255 255 255 / 6%);
    border: 1px solid rgb(255 255 255 / 14%);
    border-radius: var(--radius-sm);
  }
  .trust__item strong {
    display: block;
    color: var(--white);
  }
  .trust__item span span {
    display: block;
    font-size: var(--fs-sm);
  }
  .trust__logo {
    display: grid;
    flex: none;
    place-items: center;
    width: 64px;
    height: 64px;
    overflow: hidden;
    background: var(--white);
    border-radius: 12px;
  }
  .trust__logo :global(img) {
    width: auto;
    max-width: 84%;
    max-height: 84%;
  }
  .made__photo :global(img) {
    width: 100%;
    border: 2px solid var(--white);
    border-radius: var(--radius);
  }
  .made__photo figcaption {
    margin-top: 12px;
    font-size: var(--fs-sm);
    color: rgb(255 255 255 / 60%);
  }

  .pack .container {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: clamp(32px, 5vw, 80px);
  }
  .pack__banner {
    overflow: hidden;
    border: var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }
  .pack__banner :global(img) {
    width: 100%;
  }

  @media (max-width: 1023px) {
    .lineup__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 899px) {
    .made__grid,
    .pack .container {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 859px) {
    .condom-hero__visual {
      width: min(100%, 280px);
    }
  }
  @media (max-width: 599px) {
    .lineup__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
