---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/sections/HomeHero.astro';
import WhyZini from '../components/sections/WhyZini.astro';
import CharacterPicker from '../components/sections/CharacterPicker.astro';
import StatBand from '../components/sections/StatBand.astro';
import GelShowcase from '../components/sections/GelShowcase.astro';
import WorldStage from '../components/sections/WorldStage.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import Icon from '../components/ui/Icon.astro';
import Marquee from '../components/ui/Marquee.astro';
import { condoms } from '../data/products';
---

<BaseLayout current="home">
  <HomeHero />

  <div class="ribbon" aria-hidden="true">
    <Marquee speed={36} gap="2.2rem">
      {condoms.map((c) => (
        <>
          <span class="ribbon__word">{c.code}</span>
          <Icon name="spark" size="1.4rem" class="ribbon__spark" />
          <span class="ribbon__ko">{c.tagline}</span>
          <Icon name="spark" size="1.4rem" class="ribbon__spark" />
        </>
      ))}
    </Marquee>
  </div>

  <WhyZini />
  <CharacterPicker />
  <StatBand />
  <GelShowcase />
  <WorldStage />
  <CtaBand />
</BaseLayout>

<style>
  .ribbon {
    position: relative;
    z-index: 1;
    padding-block: 18px;
    color: var(--yellow);
    background: var(--ink);
    rotate: -1.2deg;
    margin-block: 24px -12px;
    margin-inline: -2vw;
  }
  .ribbon__word {
    font-family: var(--display);
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .ribbon__ko {
    font-size: clamp(1rem, 0.9rem + 0.5vw, 1.25rem);
    font-weight: 700;
    color: var(--white);
    white-space: nowrap;
  }
  .ribbon :global(.ribbon__spark) {
    color: var(--yellow);
  }
</style>
