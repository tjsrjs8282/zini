---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import Icon from '../components/ui/Icon.astro';
import Img from '../components/ui/Img.astro';
import Lightbox from '../components/ui/Lightbox.astro';
import Marquee from '../components/ui/Marquee.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import Zigzag from '../components/ui/Zigzag.astro';
import {
  brandFacts,
  brands,
  channels,
  dropShipping,
  goneList,
  lawsuits,
  productPower,
  strengths,
} from '../data/about';
import { img } from '../lib/images';

const half = Math.ceil(brands.length / 2);
const brandRows = [brands.slice(0, half), brands.slice(half)];

// 정식 수입 통관 증빙 — 눌러서 크게 보기
const proofs = await Promise.all(
  ['pass01.jpg', 'pass02.jpg'].map(async (name, i) => ({
    name,
    alt: `정식 수입 신고필증 ${i + 1}`,
    large: await getImage({ src: img(name), format: 'webp' }),
  })),
);
---

<BaseLayout
  current="about"
  title="회사소개"
  themeColor="#fff1cc"
  description="18년간의 성인용품 도·소매 유통 노하우와 대한민국 최초 정식 수입, 자체 브랜드 ZINI·S-SOLUTION을 가진 케어앤셰어를 소개합니다."
>
  <PageHero
    eyebrow="About Care & Share"
    title="대한민국 성인용품의<br />문을 열었어요."
    lead="18년간 쌓은 도·소매 유통 노하우, 국내 최초 정식 수입 통관, 그리고 자체 브랜드 ZINI와 S-SOLUTION까지. ZINI를 만든 케어앤셰어를 소개해요."
    tone="var(--cream)"
  >
    <div class="photo-stack" slot="visual" aria-hidden="true">
      <Img
        name="site3.jpg"
        alt=""
        widths={[300, 500]}
        sizes="260px"
        loading="eager"
        fetchpriority="high"
      />
      <Img name="13-00.jpg" alt="" widths={[300, 540]} sizes="260px" />
      <Img name="gallery_cd1.jpg" alt="" widths={[300, 450]} sizes="220px" />
    </div>
  </PageHero>

  <!-- 한눈에 보는 강점 -->
  <section class="section" aria-labelledby="strength-title">
    <div class="container">
      <SectionHead
        eyebrow="At a Glance"
        id="strength-title"
        title="한눈에 보는 케어앤셰어"
        align="center"
      />
      <ul class="strengths">
        {strengths.map((s, i) => (
          <li data-reveal style={`--i: ${i % 4}`}>
            <Img name={s.icon} alt="" width={148} />
            <p>
              <strong>{s.hl}</strong>
              {s.text}
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 01 정식 수입 -->
  <section class="chapter section on-dark" aria-labelledby="ch1-title">
    <Zigzag edge="top" color="var(--ink)" />
    <div class="container chapter__grid">
      <div class="chapter__head">
        <span class="chapter__no" aria-hidden="true">
          01
        </span>
        <SectionHead
          eyebrow="First in Korea"
          id="ch1-title"
          title="정식 수입의 문을<br />처음 열었어요."
          lead="대한민국 최초로 성인용품을 정식 수입 통관했어요. 세 번의 대법원 승소가 그 길을 만들었어요."
        />
      </div>
      <ol class="timeline">
        {lawsuits.map((l, i) => (
          <li data-reveal style={`--i: ${i}`}>
            <time>{l.date}</time>
            <div>
              <strong>{l.title}</strong>
              <p>{l.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
    <Zigzag edge="bottom" color="var(--ink)" />
  </section>

  <!-- 02 유통 채널 -->
  <section class="chapter section" aria-labelledby="ch2-title">
    <div class="container">
      <div class="chapter__head">
        <span class="chapter__no" aria-hidden="true">
          02
        </span>
        <SectionHead
          eyebrow="18 Years of Know-how"
          id="ch2-title"
          title="온라인, 오프라인,<br />그리고 B2B까지."
          lead="18년 동안 도·소매 유통과 매장 운영 노하우를 쌓았어요."
        />
      </div>
      <ul class="channels">
        {channels.map((c, i) => (
          <li data-reveal style={`--i: ${i}`}>
            <article class="channel">
              <div class="channel__shot">
                <Img
                  name={c.image}
                  alt={`${c.name} 화면`}
                  widths={[360, 500]}
                  sizes="(min-width: 1080px) 400px, (min-width: 760px) 45vw, 92vw"
                />
                <span class="channel__label">{c.label}</span>
              </div>
              <div class="channel__body">
                <h3>
                  {c.href ? (
                    <a class="stretched" href={c.href} target="_blank" rel="noopener noreferrer">
                      {c.name} <Icon name="arrow-up-right" size="18" />
                    </a>
                  ) : (
                    c.name
                  )}
                </h3>
                <p>{c.text}</p>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 03 자체 브랜드 -->
  <section class="chapter section own-brand" aria-labelledby="ch3-title">
    <div class="container own-brand__grid">
      <div>
        <div class="chapter__head">
          <span class="chapter__no" aria-hidden="true">
            03
          </span>
          <SectionHead
            eyebrow="Our Own Brand"
            id="ch3-title"
            title="대한민국 유일의<br />토털 성인용품 브랜드."
            lead="독창적인 상상력과 기술력으로 만든 심미적인 디자인. 세계 3대 디자인 어워드 중 레드닷과 iF, 그리고 한국 우수디자인(GD)을 받았어요."
          />
        </div>
        <dl class="facts">
          {brandFacts.map((f, i) => (
            <div data-reveal style={`--i: ${i}`}>
              <dt>{f.label}</dt>
              <dd>
                {f.value}
                <span>{f.unit}</span>
              </dd>
            </div>
          ))}
        </dl>
      </div>
      <figure class="own-brand__photo" data-reveal>
        <Img
          name="selling.jpg"
          alt="해외 박람회와 매거진에 소개된 ZINI, 레드닷·iF 디자인 어워드 수상 제품"
          widths={[480, 720, 990]}
          sizes="(min-width: 960px) 560px, 92vw"
        />
      </figure>
    </div>
  </section>

  <!-- 04 상품 파워 -->
  <section class="chapter section" aria-labelledby="ch4-title">
    <div class="container">
      <div class="chapter__head">
        <span class="chapter__no" aria-hidden="true">
          04
        </span>
        <SectionHead
          eyebrow="Product Power"
          id="ch4-title"
          title="18년 노하우가 만든<br />상품 파워."
        />
      </div>
      <ul class="powers">
        {productPower.map((p, i) => (
          <li class="power" data-reveal style={`--i: ${i}`}>
            <span class="power__no">{String(i + 1).padStart(2, '0')}</span>
            <h3>{p.title}</h3>
            <ul>
              {p.lines.map((line) => (
                <li>
                  <Icon name="check" size="18" />
                  {line}
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 05 대리배송 -->
  <section class="chapter section dropship" aria-labelledby="ch5-title">
    <div class="container">
      <div class="chapter__head">
        <span class="chapter__no" aria-hidden="true">
          05
        </span>
        <SectionHead
          eyebrow="Drop Shipping"
          id="ch5-title"
          title="재고 걱정 없는<br />대리배송 시스템."
          lead="주문만 받으세요. 포장부터 배송까지 케어앤셰어가 대신해요."
        />
      </div>
      <ul class="checks">
        {dropShipping.map((line, i) => (
          <li data-reveal style={`--i: ${i % 3}`}>
            <span class="checks__icon" aria-hidden="true">
              <Icon name="check" size="18" />
            </span>
            {line}
          </li>
        ))}
      </ul>
      <figure class="flow" data-reveal>
        <Img
          name="selling2.jpg"
          alt="대리배송 흐름 — 고객 주문부터 케어앤셰어 물류센터 출고, 고객 배송까지"
          widths={[640, 990]}
          sizes="(min-width: 1080px) 990px, 92vw"
        />
      </figure>
    </div>
  </section>

  <!-- 이런 성인용품은 가라 -->
  <section class="gone section" aria-labelledby="gone-title">
    <Zigzag edge="top" color="var(--yellow)" />
    <div class="container">
      <SectionHead
        eyebrow="No More"
        id="gone-title"
        title="이런 성인용품은<br />가라!"
        lead="안 팔리는 상품은 취급하지 않아요. 합법적으로 정식 수입된 정품만 다뤄요."
        align="center"
      />
      <ul class="gone__list">
        {goneList.map((g, i) => (
          <li data-reveal style={`--i: ${i}`}>
            <span class="gone__stamp" aria-hidden="true">
              GO AWAY
            </span>
            <h3>{g.title}</h3>
            <p>{g.text}</p>
          </li>
        ))}
      </ul>
    </div>
    <Zigzag edge="bottom" color="var(--yellow)" />
  </section>

  <!-- 정식 통관 증빙 -->
  <section class="section proof" aria-labelledby="proof-title">
    <div class="container proof__grid">
      <SectionHead
        eyebrow="100% Genuine"
        id="proof-title"
        title="세관을 통과한<br />정품만 팔아요."
        lead="해외 성인용품 수입 노하우로 국내 최초 정식 수입 절차를 밟았어요. 수입 신고필증을 눌러 크게 보세요."
      />
      <ul class="proof__docs" data-lightbox>
        {proofs.map((p, i) => (
          <li data-reveal style={`--i: ${i}`}>
            <a
              href={p.large.src}
              data-pswp-width={p.large.attributes.width}
              data-pswp-height={p.large.attributes.height}
            >
              <Img
                name={p.name}
                alt={p.alt}
                widths={[300, 500]}
                sizes="(min-width: 960px) 280px, 44vw"
              />
              <span class="proof__zoom">
                <Icon name="zoom" size="18" /> 크게 보기
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 파트너 브랜드 -->
  <section class="partners section" aria-labelledby="partners-title">
    <div class="container">
      <SectionHead
        eyebrow="Partners"
        id="partners-title"
        title={`해외 브랜드 ${brands.length}곳과 함께해요.`}
        align="center"
      />
    </div>
    <div class="partners__rows">
      {brandRows.map((row, r) => (
        <Marquee speed={48} reverse={r === 1} gap="16px">
          {row.map(([file, name]) => (
            <span class="logo-chip">
              <Img name={`${file}.jpg`} alt={name} width={140} />
            </span>
          ))}
        </Marquee>
      ))}
    </div>
  </section>

  <CtaBand
    title="함께 성장할<br />파트너를 찾아요."
    text="입점·도매·OEM·창업 컨설팅까지, 케어앤셰어와 이야기해요."
  />
  <Lightbox />
</BaseLayout>

<style>
  /* 히어로 사진 더미 */
  .photo-stack {
    position: relative;
    width: min(100%, 480px);
    aspect-ratio: 1.1;
  }
  .photo-stack :global(picture) {
    position: absolute;
    overflow: hidden;
    background: var(--white);
    border: var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .photo-stack :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .photo-stack :global(picture:nth-child(1)) {
    top: 0;
    left: 0;
    width: 62%;
    aspect-ratio: 4 / 3;
    rotate: -5deg;
  }
  .photo-stack :global(picture:nth-child(2)) {
    right: 0;
    top: 22%;
    width: 58%;
    aspect-ratio: 4 / 3;
    rotate: 4deg;
  }
  .photo-stack :global(picture:nth-child(3)) {
    left: 18%;
    bottom: 0;
    width: 40%;
    aspect-ratio: 1;
    rotate: -2deg;
  }

  /* 강점 */
  .strengths {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-top: clamp(40px, 5vw, 64px);
  }
  .strengths li {
    display: grid;
    justify-items: center;
    gap: 14px;
    padding: 28px 16px;
    text-align: center;
    background: var(--white);
    border: var(--border);
    border-radius: var(--radius);
  }
  .strengths :global(img) {
    width: 88px;
  }
  .strengths p {
    display: grid;
    line-height: 1.5;
    color: var(--muted);
  }
  .strengths strong {
    font-size: 1.125rem;
    color: var(--ink);
  }

  /* 챕터 머리 */
  .chapter__head {
    position: relative;
  }
  .chapter__no {
    display: block;
    margin-bottom: 12px;
    font-family: var(--display);
    font-size: clamp(3.5rem, 2.4rem + 4vw, 6rem);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: transparent;
    -webkit-text-stroke: 2px currentColor;
  }
  .on-dark .chapter__no {
    color: transparent;
    -webkit-text-stroke-color: var(--yellow);
  }

  /* 01 타임라인 */
  .chapter__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(40px, 6vw, 96px);
  }
  .timeline {
    position: relative;
    display: grid;
    gap: 14px;
  }
  .timeline li {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    align-items: start;
    gap: 20px;
    padding: 22px 24px;
    background: rgb(255 255 255 / 6%);
    border: 1px solid rgb(255 255 255 / 14%);
    border-radius: var(--radius);
  }
  .timeline time {
    font-family: var(--display);
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--yellow);
  }
  .timeline strong {
    display: block;
    font-size: 1.125rem;
    color: var(--white);
  }
  .timeline p {
    margin-top: 2px;
  }

  /* 02 채널 */
  .channels {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: clamp(40px, 5vw, 64px);
  }
  .channel {
    position: relative;
    height: 100%;
    overflow: hidden;
    background: var(--white);
    border: var(--border);
    border-radius: var(--radius);
    transition:
      transform 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out);
  }
  .channel:has(a):hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow-lg);
  }
  .channel__shot {
    position: relative;
    border-bottom: var(--border);
  }
  .channel__shot :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .channel__label {
    position: absolute;
    top: 14px;
    left: 14px;
    padding: 4px 10px;
    font-family: var(--display);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--ink);
    background: var(--yellow);
    border: var(--border);
    border-radius: 999px;
  }
  .channel__body {
    display: grid;
    gap: 6px;
    padding: 22px 24px 26px;
  }
  .channel__body h3 {
    font-family: var(--display);
    font-size: 1.125rem;
    letter-spacing: -0.02em;
  }
  .channel__body h3 a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .channel__body p {
    color: var(--muted);
  }

  /* 03 브랜드 */
  .own-brand {
    background: var(--cream);
  }
  .own-brand__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(40px, 6vw, 96px);
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: 40px;
  }
  .facts div {
    display: flex;
    flex-direction: column-reverse;
    gap: 6px;
    padding: 20px;
    background: var(--white);
    border: var(--border);
    border-radius: var(--radius-sm);
  }
  .facts dt {
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .facts dd {
    font-family: var(--display);
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.6rem);
    font-weight: 800;
    line-height: 1;
    color: var(--ink);
  }
  .facts dd span {
    margin-left: 3px;
    font-family: var(--sans);
    font-size: 1rem;
  }
  .own-brand__photo :global(img) {
    width: 100%;
    border: var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  /* 04 상품 파워 */
  .powers {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-top: clamp(40px, 5vw, 64px);
  }
  .power {
    display: grid;
    align-content: start;
    gap: 12px;
    padding: 26px 24px 28px;
    background: var(--white);
    border: var(--border);
    border-radius: var(--radius);
  }
  .power__no {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    font-family: var(--display);
    font-size: 0.875rem;
    font-weight: 800;
    color: var(--ink);
    background: var(--yellow);
    border: var(--border);
    border-radius: 50%;
  }
  .power h3 {
    font-size: 1.25rem;
  }
  .power ul {
    display: grid;
    gap: 8px;
  }
  .power li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 8px;
    color: var(--muted);
  }
  .power li :global(.icon) {
    margin-top: 0.3em;
    color: var(--ink);
  }

  /* 05 대리배송 */
  .dropship {
    padding-top: 0;
  }
  .checks {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: clamp(36px, 5vw, 56px);
  }
  .checks li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 20px;
    font-weight: 600;
    color: var(--ink);
    background: var(--white);
    border: var(--border);
    border-radius: 999px;
  }
  .checks__icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 30px;
    height: 30px;
    color: var(--white);
    background: var(--ink);
    border-radius: 50%;
  }
  .flow {
    margin-top: 28px;
    padding: clamp(16px, 3vw, 32px);
    background: var(--white);
    border: var(--border);
    border-radius: var(--radius);
  }
  .flow :global(img) {
    width: 100%;
  }

  /* 가라! */
  .gone {
    background: var(--yellow);
  }
  .gone__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: clamp(40px, 5vw, 64px);
  }
  .gone__list li {
    position: relative;
    display: grid;
    align-content: start;
    gap: 12px;
    padding: 64px 26px 30px;
    background: var(--white);
    border: var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
  }
  .gone__stamp {
    position: absolute;
    top: 20px;
    left: 24px;
    padding: 3px 10px;
    font-family: var(--display);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: #d93a3a;
    border: 2px solid #d93a3a;
    border-radius: 6px;
    rotate: -6deg;
  }
  .gone__list h3 {
    font-size: 1.3rem;
  }
  .gone__list p {
    color: var(--muted);
  }

  /* 통관 증빙 */
  .proof__grid {
    display: grid;
