const brands = [
  ['ave', 'AVE'],
  ['bijoux', 'Bijoux Indiscrets'],
  ['blueline', 'Blue Line'],
  ['btt', 'Big Teaze Toys'],
  ['feelz', 'Feelztoys'],
  ['ff', 'Fun Factory'],
  ['fl', 'Fleshlight'],
  ['fsg', 'Fifty Shades of Grey'],
  ['glas', 'Gläs'],
  ['hustler', 'Hustler'],
  ['iroha', 'iroha'],
  ['jejoue', 'Je Joue'],
  ['kawaii', 'Kawaii'],
  ['laid', 'Laid'],
  ['liberator', 'Liberator'],
  ['lux', 'Lux Fetish'],
  ['nomitang', 'Nomi Tang'],
  ['npg', 'NPG'],
  ['omb', 'OhMiBod'],
  ['ondo', 'ONDO!'],
  ['pipedream', 'Pipedream'],
  ['rends', 'Rends'],
  ['riannes', 'Rianne S'],
  ['satisfyer', 'Satisfyer'],
  ['so', 'Screaming O'],
  ['sportsheet', 'Sportsheets'],
