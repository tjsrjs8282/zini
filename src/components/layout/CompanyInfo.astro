---
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import { company, site } from '../../data/site';
import { img } from '../../lib/images';
---

<div class="company">
  <a href={site.shopUrl} class="company-logo" target="_blank" rel="noopener noreferrer">
    <Image src={img('bururuCom.png')} alt="부르르닷컴" width={200} densities={[1, 2]} />
  </a>
  <p class="label">{company.bank}</p>
  <span class="phoneNum">{company.account}</span>
  <p class="label">{company.name}</p>
  <address>
    <span>대표이사 : {company.ceo}</span>
    <span aria-hidden="true">ㅣ</span>
    <span>사업자등록번호 : {company.bizNumber}</span>
    <br />
    <span>통신판매업 : {company.mailOrderNumber}</span>
    <span aria-hidden="true">ㅣ</span>
    <span>의료기기 판매신고 : {company.medicalDeviceNumber}</span>
    <br />
    <span>주소 : {company.address}</span>
    <br />
    <span>E-mail :</span>
    <a class="email" href={`mailto:${company.email}`}>
      {company.email}
    </a>
    <span>
      T. {company.tel} F. {company.fax}
    </span>
    <br />
    <span>호스팅제공 : {company.hosting}</span>
  </address>
  <p class="cs">
    <Icon name="phone" class="phone-icon" />
    <span class="visually-hidden">고객센터</span>
    <span class="phoneNum">{company.csPhone}</span>
  </p>
  <slot />
</div>

<style>
  .company-logo {
    display: inline-block;
    margin-bottom: 1rem;
  }
  .company-logo img {
    width: 200px;
    height: auto;
  }
  .label {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 700;
    color: #fff;
  }
  .company span {
    display: inline-block;
    font-size: 0.8rem;
    color: #eee;
  }
  .company .phoneNum {
    font-size: 2rem;
    font-weight: 700;
    color: var(--c-orange);
  }
  address {
    margin: 0 0 1.5rem;
  }
  .email {
    display: inline-block;
    margin: 0 5px;
    font-size: 0.8rem;
    color: var(--c-orange);
  }
  .email:hover {
    color: #222;
  }
  .cs {
    display: flex;
    align-items: center;
    margin: 0;
  }
  .phone-icon {
    --icon-cutout: var(--company-bg, var(--c-teal));
    margin-right: 10px;
    font-size: 1.75rem;
    color: #fff;
  }
</style>
