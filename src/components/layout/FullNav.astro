---
import ZiniFace from '../ui/ZiniFace.astro';
import SocialLinks from '../ui/SocialLinks.astro';
import { navItems } from '../../data/site';
import type { NavId } from '../../data/site';
import { url } from '../../lib/url';

interface Props {
  current: NavId;
}

const { current } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<!-- 전체 메뉴: 네이티브 <dialog>로 포커스 가두기·ESC 닫기·배경 비활성화를 처리합니다. -->
<dialog class="full-nav" id="full-nav" aria-label="전체 메뉴" data-full-nav>
  <div class="logo">
    <a href={url()} aria-label="ZINI 홈">
      <ZiniFace width={150} height={100} />
    </a>
  </div>
  <nav class="nav2" aria-label="전체 메뉴">
    <ul>
      {navItems.map((item, i) => (
        <li>
          <a href={url(item.href)} aria-current={item.id === current ? 'page' : undefined}>
            <span>{pad(i + 1)}.</span>
            {i === 0 ? 'Home' : item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <SocialLinks variant="circle" />
  <div class="corner-circle">
    <button type="button" class="nav-close" aria-label="메뉴 닫기" data-nav-close>
      <span></span>
      <span></span>
    </button>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-full-nav]');
  const openButton = document.querySelector<HTMLButtonElement>('[data-nav-open]');

  if (dialog && openButton) {
    openButton.addEventListener('click', () => {
      dialog.showModal();
      openButton.setAttribute('aria-expanded', 'true');
    });
    dialog.querySelector('[data-nav-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => openButton.setAttribute('aria-expanded', 'false'));
  }
</script>

<style>
  .full-nav {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 3.75rem;
    overflow-x: hidden;
    color: var(--c-ink);
    background: var(--c-yellow);
    border: 0;
    opacity: 0;
    transform: translateY(-100px);
    transition:
      opacity 0.4s ease-in-out,
      transform 0.4s ease-in-out,
      overlay 0.4s allow-discrete,
      display 0.4s allow-discrete;
  }
  .full-nav[open] {
    opacity: 1;
    transform: translateY(0);
  }
  @starting-style {
    .full-nav[open] {
      opacity: 0;
      transform: translateY(-100px);
    }
  }
  .full-nav::backdrop {
    background: transparent;
  }
  :global(html:has(.full-nav[open])) {
    overflow: hidden;
  }

  .logo {
    display: flex;
    justify-content: center;
    padding: 4rem;
  }

  .nav2 {
    display: flex;
    justify-content: center;
  }
  .nav2 ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    max-width: 700px;
  }
  .nav2 li {
    display: flex;
    flex: 50%;
    line-height: 70px;
    background-color: #f5f5f5;
    border-bottom: 0 solid var(--c-amber);
    border-right: 0 solid var(--c-amber);
    transition: all 1s;
  }
  .full-nav[open] .nav2 li {
    border-bottom-width: 15px;
    border-right-width: 15px;
  }
  @starting-style {
    .full-nav[open] .nav2 li {
      border-bottom-width: 0;
      border-right-width: 0;
    }
  }
  .nav2 a {
    display: block;
    width: 100%;
    height: 100%;
    font-size: 1.4em;
    color: var(--c-ink);
  }
  .nav2 a span {
    display: inline-block;
    margin: 0 20px;
    color: #b9b9b9;
  }
  .nav2 li:hover {
    background-color: var(--c-red);
  }
  .nav2 li:hover a,
  .nav2 li:hover a span {
    color: #fff;
  }

  .corner-circle {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 2;
    width: 120px;
    height: 120px;
    background-color: #fff;
    border-radius: 0 0 0 120px;
  }
  .nav-close {
    position: absolute;
    top: 30px;
    right: 30px;
    display: block;
    width: 30px;
    height: 30px;
  }
  .nav-close span {
    position: absolute;
    top: 14px;
    display: block;
    width: 40px;
    height: 2px;
    background: var(--c-text);
  }
  .nav-close span:nth-child(1) {
    transform: rotate(45deg);
  }
  .nav-close span:nth-child(2) {
    transform: rotate(-45deg);
  }

  @media (max-width: 550px) {
    .logo {
      display: none;
    }
    .nav2 ul {
      display: block;
      width: 100%;
    }
    .corner-circle {
      width: 100px;
      height: 100px;
    }
    .nav-close {
      top: 25px;
    }
  }
</style>
