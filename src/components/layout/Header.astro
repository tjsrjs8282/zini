---
import Icon from '../ui/Icon.astro';
import Img from '../ui/Img.astro';
import SocialLinks from '../ui/SocialLinks.astro';
import Wordmark from '../ui/Wordmark.astro';
import ZiniFace from '../ui/ZiniFace.astro';
import { navItems, site } from '../../data/site';
import type { NavId } from '../../data/site';
import { condoms } from '../../data/products';
import { url } from '../../lib/url';

interface Props {
  current: NavId;
}

const { current } = Astro.props;
const menuItems = [{ id: 'home', label: '홈', en: 'Home', href: '' }, ...navItems];
---

<header class="site-header" data-header>
  <div class="bar container">
    <a class="brand" href={url()} aria-label="ZINI 홈">
      <ZiniFace class="brand__face" />
      <Wordmark class="brand__word" />
    </a>

    <nav class="gnb" aria-label="주 메뉴">
      <ul>
        {navItems.map((item) => (
          <li>
            <a href={url(item.href)} aria-current={item.id === current ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <a
        class="btn btn--sm btn--ink shop"
        href={site.shopUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        공식몰 <Icon name="arrow-up-right" />
        <span class="visually-hidden">(새 창)</span>
      </a>
      <button
        type="button"
        class="menu-toggle"
        aria-haspopup="dialog"
        aria-controls="site-menu"
        aria-expanded="false"
        data-menu-open
      >
        <span class="menu-toggle__bars" aria-hidden="true">
          <span></span>
          <span></span>
        </span>
        <span class="visually-hidden">전체 메뉴 열기</span>
      </button>
    </div>
  </div>
</header>

<dialog id="site-menu" class="menu" aria-label="전체 메뉴" data-menu>
  <div class="menu__bar container">
    <a class="brand" href={url()} aria-label="ZINI 홈">
      <ZiniFace class="brand__face" />
      <Wordmark class="brand__word" />
    </a>
    <button type="button" class="menu__close" data-menu-close>
      <Icon name="close" size="24" />
      <span class="visually-hidden">메뉴 닫기</span>
    </button>
  </div>

  <nav class="menu__nav container" aria-label="전체 메뉴">
    <ol>
      {menuItems.map((item, i) => (
        <li style={`--i: ${i}`}>
          <a href={url(item.href)} aria-current={item.id === current ? 'page' : undefined}>
            <span class="menu__en">{item.en}</span>
            <span class="menu__ko">{item.label}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>

  <div class="menu__foot container">
    <a class="btn btn--ink" href={site.shopUrl} target="_blank" rel="noopener noreferrer">
      공식몰 바로가기 <Icon name="arrow-up-right" />
      <span class="visually-hidden">(새 창)</span>
    </a>
    <SocialLinks />
  </div>

  <ul class="menu__crew" aria-hidden="true">
    {condoms.map((c, i) => (
      <li style={`--i: ${i}`}>
        <Img name={c.character} alt="" width={116} />
      </li>
    ))}
  </ul>
</dialog>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const menu = document.querySelector<HTMLDialogElement>('[data-menu]');
  const openButton = document.querySelector<HTMLButtonElement>('[data-menu-open]');

  // 스크롤하면 배경을 깔고, 내려갈 때는 숨겼다가 올라오면 다시 보여 줍니다.
  if (header) {
    let lastY = window.scrollY;
    let ticking = false;
    const update = () => {
      const y = window.scrollY;
      header.classList.toggle('is-scrolled', y > 8);
      if (y > lastY + 4 && y > 280) header.classList.add('is-hidden');
      else if (y < lastY - 4 || y <= 280) header.classList.remove('is-hidden');
      lastY = y;
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      },
      { passive: true },
    );
    update();
  }

  // 전체 메뉴: 네이티브 <dialog>로 포커스 가두기·ESC 닫기를 처리합니다.
  if (menu && openButton) {
    openButton.addEventListener('click', () => {
      menu.showModal();
      openButton.setAttribute('aria-expanded', 'true');
    });
    menu.querySelector('[data-menu-close]')?.addEventListener('click', () => menu.close());
    menu.addEventListener('close', () => openButton.setAttribute('aria-expanded', 'false'));
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) menu.close();
    });
    window.matchMedia('(min-width: 960px)').addEventListener('change', (event) => {
      if (event.matches && menu.open) menu.close();
    });
  }
</script>

<style>
  /* ---------- 상단 바 ---------- */
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header-h);
    view-transition-name: site-header;
    transition:
      transform 0.45s var(--ease-out),
      background-color 0.3s,
      box-shadow 0.3s;
  }
  .site-header.is-scrolled {
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    box-shadow: 0 1px 0 var(--line);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    backdrop-filter: saturate(1.4) blur(14px);
  }
  .site-header.is-hidden:not(:focus-within) {
    transform: translateY(-105%);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 100%;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    border-radius: 8px;
  }
  .brand__face {
    width: 40px;
  }
  .brand__word {
    width: 70px;
  }
  .brand:hover :global(.lid) {
    animation-duration: 0.8s;
  }

  .gnb ul {
    display: flex;
    gap: 2px;
  }
  .gnb a {
    display: block;
    padding: 9px 16px;
    font-size: 0.96875rem;
    font-weight: 700;
    color: var(--ink);
    border-radius: 999px;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .gnb a:hover {
    background: rgb(21 20 19 / 8%);
  }
  .gnb a[aria-current='page'] {
    color: var(--white);
    background: var(--ink);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .menu-toggle {
    display: none;
    place-items: center;
    width: 46px;
    height: 46px;
    background: var(--white);
    border: var(--border);
    border-radius: 50%;
    box-shadow: 3px 3px 0 var(--ink);
    transition:
      transform 0.2s var(--ease-out),
      box-shadow 0.2s var(--ease-out);
  }
  .menu-toggle:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 var(--ink);
  }
  .menu-toggle__bars {
    display: grid;
    gap: 6px;
  }
  .menu-toggle__bars span {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--ink);
    border-radius: 2px;
  }
  .menu-toggle__bars span:last-child {
    width: 12px;
  }

  @media (max-width: 959px) {
    .gnb {
      display: none;
    }
    .menu-toggle {
      display: grid;
    }
  }
  @media (max-width: 420px) {
    .shop {
      display: none;
    }
  }

  /* ---------- 전체 메뉴 ---------- */
  .menu {
    position: fixed;
    inset: 0;
    flex-direction: column;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    overflow: hidden auto;
    color: var(--ink);
    background: var(--yellow);
    opacity: 0;
    transition:
      opacity 0.35s var(--ease-out),
      overlay 0.35s allow-discrete,
      display 0.35s allow-discrete;
  }
  .menu[open] {
    display: flex;
    opacity: 1;
  }
  @starting-style {
    .menu[open] {
      opacity: 0;
    }
  }
  .menu::backdrop {
    background: transparent;
  }
  :global(html:has(.menu[open])) {
    overflow: hidden;
  }

  .menu__bar {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
  }
  .menu__close {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    background: var(--white);
    border: var(--border);
    border-radius: 50%;
    box-shadow: 3px 3px 0 var(--ink);
  }

  .menu__nav {
    display: flex;
    flex: 1;
    align-items: center;
    padding-block: 16px;
  }
  .menu__nav ol {
    width: 100%;
    border-top: var(--border);
  }
  .menu__nav li {
    border-bottom: var(--border);
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 0.5s var(--ease-out),
      transform 0.5s var(--ease-out);
    transition-delay: calc(var(--i) * 55ms + 80ms);
  }
  .menu[open] .menu__nav li {
    opacity: 1;
    transform: none;
  }
  @starting-style {
    .menu[open] .menu__nav li {
      opacity: 0;
      transform: translateY(22px);
    }
  }
  .menu__nav a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 4px;
  }
  .menu__en {
    font-family: var(--display);
    font-size: clamp(2rem, 8.5vw, 3.4rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    transition: transform 0.3s var(--ease-out);
  }
  .menu__nav a:hover .menu__en {
    transform: translateX(8px);
  }
  .menu__ko {
    font-size: 1rem;
    font-weight: 700;
  }
  .menu__nav a[aria-current='page'] .menu__en {
    color: transparent;
    -webkit-text-stroke: 2px var(--ink);
  }

  .menu__foot {
    display: flex;
    flex: none;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 12px 108px;
  }

  .menu__crew {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    justify-content: center;
    gap: clamp(2px, 2vw, 18px);
    pointer-events: none;
  }
  .menu__crew li {
    width: clamp(46px, 13vw, 76px);
    transform: translateY(100%);
    transition: transform 0.7s var(--ease-spring);
    transition-delay: calc(var(--i) * 70ms + 200ms);
  }
  .menu[open] .menu__crew li {
    transform: translateY(22%);
  }
  @starting-style {
    .menu[open] .menu__crew li {
      transform: translateY(100%);
    }
  }
</style>
