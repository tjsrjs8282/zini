---
import { getImage } from 'astro:assets';
import Zigzag from '../ui/Zigzag.astro';
import { img } from '../../lib/images';
import { url } from '../../lib/url';

const background = await getImage({ src: img('back.jpg'), format: 'webp' });
---

<section class="services" style={`--services-bg: url(${background.src})`}>
  <Zigzag edge="top" point="down" inset />
  <div class="container text-center">
    <p class="kicker">NEW UPDATES</p>
    <h2>Lorem ipsum dolor sit amet, consectetur.</h2>
    <a href={url('gallery.html')} class="btn-pill">
      MORE
    </a>
  </div>
  <Zigzag edge="bottom" point="up" inset />
</section>

<style>
  .services {
    position: relative;
    padding: 150px 0;
    background: var(--services-bg) center / cover no-repeat fixed;
  }
  .kicker {
    margin-bottom: 2.5rem;
    letter-spacing: 2px;
    color: #fff;
  }
  h2 {
    font-size: 2em;
    font-weight: 700;
    color: #fff;
  }
  /* iOS 등 fixed 배경을 지원하지 않는 터치 기기에서는 일반 배경으로 */
  @media (hover: none) {
    .services {
      background-attachment: scroll;
    }
  }
</style>
