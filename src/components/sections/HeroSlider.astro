---
import 'swiper/css';
import 'swiper/css/effect-fade';
import 'swiper/css/pagination';
import { Image } from 'astro:assets';
import SocialLinks from '../ui/SocialLinks.astro';
import { heroSlides } from '../../data/banners';
import { img } from '../../lib/images';
import { url } from '../../lib/url';
---

<section class="hero" aria-label="메인 배너">
  <div class="swiper" data-hero-swiper>
    <div class="swiper-wrapper">
      {heroSlides.map((slide, i) => (
        <div class:list={['swiper-slide', 'hero-slide', { 'hero-slide--dark': slide.dark }]}>
          <Image
            class="hero-img"
            src={img(slide.image)}
            alt={slide.alt}
            widths={[640, 960, 1280, 1920]}
            sizes="100vw"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
          />
          <div class="container">
            <div class="hero-content d-none d-lg-block">
              <h2 class="hero-title">{slide.title}</h2>
              <p>
                <span>{slide.lead}</span>
                {slide.body}
              </p>
              <a href={url(slide.href)} class="btn-pill">
                Click Here
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
    <div class="swiper-pagination pager-squares"></div>
  </div>
  <SocialLinks variant="hero" class="hero-social d-none d-lg-flex" />
</section>

<script>
  import { Autoplay, EffectFade, Pagination } from 'swiper/modules';
  import { createSwiper } from '../../scripts/swiper';

  document.querySelectorAll<HTMLElement>('[data-hero-swiper]').forEach((el) => {
    createSwiper(el, {
      modules: [EffectFade, Autoplay, Pagination],
      effect: 'fade',
      fadeEffect: { crossFade: true },
      loop: true,
      speed: 800,
      autoplay: { delay: 4000, disableOnInteraction: false, pauseOnMouseEnter: true },
      pagination: { el: el.querySelector<HTMLElement>('.swiper-pagination'), clickable: true },
    });
  });
</script>

<style>
  .hero {
    position: relative;
  }
  .hero .swiper {
    --swiper-pagination-bottom: 20px;
  }
  .hero-img {
    display: block;
    width: 100%;
    height: auto;
  }
  .hero-content {
    position: absolute;
    top: 290px;
    width: 1000px;
    padding: 10px;
    color: #f1f1f1;
    text-align: left;
  }
  .hero-title {
    font-size: 3em;
    font-weight: 700;
    letter-spacing: 2px;
    color: #fff;
    text-transform: uppercase;
  }
  .hero-slide--dark .hero-title,
  .hero-slide--dark p {
    color: #000;
  }
  .hero-social {
    position: absolute;
    top: 55%;
    right: 127px;
    z-index: 2;
    transform: translateY(-50%);
  }
</style>
