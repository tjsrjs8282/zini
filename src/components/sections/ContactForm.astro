---
import Icon from '../ui/Icon.astro';

// PUBLIC_CONTACT_ENDPOINT(예: Formspree 주소)를 넣으면 그곳으로 전송합니다.
// 비워 두면 데모 모드 — 실제로 보내지 않고, 데모라서 전송되지 않았다는 안내만 보여 줍니다.
const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT ?? '';
const topics = ['제휴·입점', '도매 거래', 'OEM·ODM', '수입·통관 대행', '창업 컨설팅', '기타'];
---

<form class="form" data-contact-form data-endpoint={endpoint} novalidate>
  <div class="form__row">
    <div class="field">
      <label for="cf-name">
        이름{' '}
        <span class="req" aria-hidden="true">
          *
        </span>
      </label>
      <input id="cf-name" name="name" autocomplete="name" required aria-describedby="cf-name-err" />
      <p class="field__error" id="cf-name-err"></p>
    </div>
    <div class="field">
      <label for="cf-email">
        이메일{' '}
        <span class="req" aria-hidden="true">
          *
        </span>
      </label>
      <input
        id="cf-email"
        name="email"
        type="email"
        autocomplete="email"
        inputmode="email"
        required
        aria-describedby="cf-email-err"
      />
      <p class="field__error" id="cf-email-err"></p>
    </div>
  </div>

  <div class="field">
    <label for="cf-company">
      회사명 <span class="opt">(선택)</span>
    </label>
    <input id="cf-company" name="company" autocomplete="organization" />
  </div>

  <fieldset class="field">
    <legend>문의 유형</legend>
    <div class="topics">
      {topics.map((t, i) => (
        <label class="topic">
          <input type="radio" name="topic" value={t} checked={i === 0} />
          <span>{t}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <div class="field">
    <label for="cf-message">
      문의 내용{' '}
      <span class="req" aria-hidden="true">
        *
      </span>
    </label>
    <textarea
      id="cf-message"
      name="message"
      rows="6"
      minlength="10"
      required
      placeholder="궁금한 점이나 제안하실 내용을 적어 주세요."
      aria-describedby="cf-message-err"
    ></textarea>
    <p class="field__error" id="cf-message-err"></p>
  </div>

  <div class="field">
    <label class="agree">
      <input type="checkbox" name="agree" required aria-describedby="cf-agree-err" />
      <span>개인정보(이름·이메일) 수집·이용에 동의합니다. 문의 답변 후 바로 파기해요.</span>
    </label>
    <p class="field__error" id="cf-agree-err"></p>
  </div>

  <div class="form__foot">
    <button class="btn btn--ink" type="submit">
      문의 보내기 <Icon name="arrow-right" />
    </button>
    <p class="form__status" role="status" aria-live="polite"></p>
  </div>
</form>

<script>
  const messages: Record<string, string> = {
    name: '이름을 적어 주세요.',
    email: '이메일을 적어 주세요.',
    message: '문의 내용을 10자 이상 적어 주세요.',
    agree: '개인정보 수집·이용에 동의해 주세요.',
  };

  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('.form__status');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const fields = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]')];

    const setStatus = (text: string, tone: 'ok' | 'error' | '' = '') => {
      if (!status) return;
      status.textContent = text;
      status.dataset.tone = tone;
    };

    const check = (field: HTMLInputElement | HTMLTextAreaElement) => {
      const error = document.getElementById(field.getAttribute('aria-describedby') ?? '');
      let text = '';
      if (!field.validity.valid) {
        text =
          field.validity.typeMismatch && field.name === 'email'
            ? '이메일 주소 형식을 확인해 주세요. (예: name@example.com)'
            : (messages[field.name] ?? '이 항목을 확인해 주세요.');
      }
      field.toggleAttribute('aria-invalid', Boolean(text));
      if (error) error.textContent = text;
      return !text;
    };

    // 한 번 틀린 칸은 고치는 즉시 다시 확인합니다.
    fields.forEach((field) =>
      field.addEventListener('input', () => {
        if (field.hasAttribute('aria-invalid')) check(field);
      }),
    );

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const invalid = fields.filter((field) => !check(field));
      if (invalid.length) {
        invalid[0]?.focus();
        setStatus('표시된 항목을 확인해 주세요.', 'error');
        return;
      }

      const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
      const endpoint = form.dataset.endpoint;

      if (!endpoint) {
        form.reset();
        setStatus(
          `${data.name}님, 고마워요! 포트폴리오 데모라 실제로 전송되지는 않았어요. 입력한 내용은 어디에도 저장되지 않아요.`,
          'ok',
        );
        return;
      }

      if (button) button.disabled = true;
      setStatus('보내는 중이에요…');
      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });
        if (!response.ok) throw new Error(String(response.status));
        form.reset();
        setStatus('문의가 접수됐어요. 담당자가 확인 후 연락드릴게요!', 'ok');
      } catch {
        setStatus('전송하지 못했어요. 잠시 후 다시 시도해 주세요.', 'error');
      } finally {
        if (button) button.disabled = false;
      }
    });
  });
</script>

<style>
  .form {
    display: grid;
    gap: 22px;
  }
  .form__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }
  .field {
    display: grid;
    gap: 8px;
  }
  .field label,
  .field legend {
    font-weight: 700;
    color: var(--ink);
  }
  .field legend {
    margin-bottom: 8px;
  }
  .req {
    color: #d93a3a;
  }
  .opt {
    font-weight: 500;
    color: var(--muted);
  }
  input:not([type='radio'], [type='checkbox']),
  textarea {
    width: 100%;
    padding: 14px 16px;
    font-size: 1rem;
    color: var(--ink);
    background: var(--white);
    border: var(--border);
    border-radius: var(--radius-sm);
    transition:
      box-shadow 0.2s,
      border-color 0.2s;
  }
  textarea {
    resize: vertical;
  }
  input:not([type='radio'], [type='checkbox']):focus-visible,
  textarea:focus-visible {
    outline: none;
    box-shadow: 4px 4px 0 var(--ink);
  }
  [aria-invalid] {
    border-color: #d93a3a !important;
    background: #fff5f5 !important;
  }
  .field__error {
    min-height: 0;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: #c22d2d;
  }
  .field__error:empty {
    display: none;
  }

  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .topic input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .topic span {
    display: inline-block;
    padding: 8px 16px;
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--ink);
    background: var(--white);
    border: var(--border);
    border-radius: 999px;
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .topic input:checked + span {
    color: var(--white);
    background: var(--ink);
  }
  .topic input:focus-visible + span {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }

  .agree {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-weight: 500 !important;
    color: var(--text) !important;
    cursor: pointer;
  }
  .agree input {
    flex: none;
    width: 20px;
    height: 20px;
    margin-top: 3px;
    accent-color: var(--ink);
  }

  .form__foot {
    display: grid;
    justify-items: start;
    gap: 14px;
  }
  .form__status:empty {
    display: none;
  }
  .form__status {
    padding: 14px 18px;
    font-weight: 600;
    border: var(--border);
    border-radius: var(--radius-sm);
  }
  .form__status[data-tone='ok'] {
    background: #e7f7ea;
  }
  .form__status[data-tone='error'] {
    background: #fff0f0;
  }

  @media (max-width: 559px) {
    .form__row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
