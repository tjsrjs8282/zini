---
import { company } from '../../data/site';

// PUBLIC_CONTACT_ENDPOINT(예: Formspree 주소)를 설정하면 그곳으로 전송하고,
// 없으면 사용자의 메일 앱을 열어 회사 메일로 보냅니다.
const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT ?? '';
---

<form class="contact-form" data-contact-form data-endpoint={endpoint} data-email={company.email}>
  <label class="visually-hidden" for="contact-name">
    이름
  </label>
  <input
    id="contact-name"
    name="name"
    type="text"
    placeholder="Full name"
    autocomplete="name"
    required
  />

  <label class="visually-hidden" for="contact-email">
    이메일
  </label>
  <input
    id="contact-email"
    name="email"
    type="email"
    placeholder="Email Address"
    autocomplete="email"
    required
  />

  <label class="visually-hidden" for="contact-message">
    문의 내용
  </label>
  <textarea
    id="contact-message"
    name="message"
    rows="5"
    placeholder="Message.."
    required
  ></textarea>

  <button type="submit" class="send-btn">
    SEND
  </button>
  <p class="form-status" role="status" aria-live="polite"></p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('.form-status');
    const setStatus = (message: string) => {
      if (status) status.textContent = message;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
      const { endpoint, email } = form.dataset;

      if (!endpoint) {
        const subject = encodeURIComponent(`[ZINI 문의] ${data.name}`);
        const body = encodeURIComponent(
          `${data.message}\n\n보낸 사람: ${data.name} <${data.email}>`,
        );
        window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
        setStatus('메일 앱에서 내용을 확인한 뒤 보내 주세요.');
        return;
      }

      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) button.disabled = true;
      setStatus('보내는 중입니다…');
      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });
        if (!response.ok) throw new Error(String(response.status));
        form.reset();
        setStatus('문의가 접수되었습니다. 감사합니다!');
      } catch {
        setStatus('전송에 실패했습니다. 잠시 후 다시 시도하거나 메일로 문의해 주세요.');
      } finally {
        if (button) button.disabled = false;
      }
    });
  });
</script>

<style>
  input,
  textarea {
    display: block;
    width: 100%;
    margin-bottom: 20px;
    padding: 8px 17px;
    font-size: 17px;
    font-weight: 700;
    line-height: 1.5;
    color: #fff;
    background: transparent;
    border: 1px solid #fff;
    border-radius: 0;
  }
  input::placeholder,
  textarea::placeholder {
    color: #6c757d;
  }
  input:focus,
  textarea:focus {
    outline: 3px solid var(--c-orange);
    outline-offset: 0;
  }
  .send-btn {
    display: inline-block;
    padding: 12px 25px;
    font-size: 17px;
    font-weight: 700;
    line-height: 1.5;
    color: #fff;
    border: 2px solid #fff;
    border-radius: 0.3rem;
    transition: color 0.15s;
  }
  .send-btn:hover {
    color: #585858;
  }
  .send-btn:disabled {
    opacity: 0.6;
  }
  .form-status {
    min-height: 1.5em;
    margin-top: 1rem;
    color: #fff;
  }
</style>
