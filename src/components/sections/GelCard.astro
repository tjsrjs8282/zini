---
import Img from '../ui/Img.astro';
import { formatPrice } from '../../data/products';
import type { Gel } from '../../data/products';
import { url } from '../../lib/url';

interface Props {
  gel: Gel;
  /** 지정하면 카드 전체가 이 페이지로 가는 링크가 됩니다. */
  href?: string;
  detailed?: boolean;
}

const { gel, href, detailed = false } = Astro.props;
---

<article
  class:list={['gel-card', { 'gel-card--detailed': detailed }]}
  style={`--tint: ${gel.tint}`}
>
  <div class="gel-card__media">
    <Img
      name={gel.image}
      alt={gel.name}
      widths={[300, 450, 600]}
      sizes="(min-width: 1080px) 400px, (min-width: 640px) 45vw, 90vw"
    />
    {gel.badge && <span class="gel-card__badge">{gel.badge}</span>}
  </div>
  <div class="gel-card__body">
    <p class="gel-card__en">{gel.en}</p>
    <h3 class="gel-card__name">
      {href ? (
        <a class="stretched" href={url(href)}>
          {gel.name}
        </a>
      ) : (
        gel.name
      )}
    </h3>
    {detailed && <p class="gel-card__desc">{gel.description}</p>}
    {detailed && <p class="gel-card__pick">{gel.pick}</p>}
    <p class="gel-card__meta">
      <span>{gel.spec}</span>
      <strong>{formatPrice(gel.price)}</strong>
    </p>
  </div>
</article>

<style>
  .gel-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: var(--white);
    border: var(--border);
    border-radius: var(--radius);
    transition:
      transform 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out);
  }
  .gel-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow-lg);
  }
  .gel-card__media {
    position: relative;
    background: var(--tint);
    border-bottom: var(--border);
  }
  .gel-card__media :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    mix-blend-mode: multiply;
    transition: transform 0.6s var(--ease-out);
  }
  .gel-card:hover .gel-card__media :global(img) {
    transform: scale(1.05);
  }
  .gel-card__badge {
    position: absolute;
    top: 16px;
    left: 16px;
    padding: 4px 10px;
    font-family: var(--display);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--white);
    background: var(--ink);
    border-radius: 999px;
  }
  .gel-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 6px;
    padding: 20px 22px 22px;
  }
  .gel-card__en {
    font-family: var(--display);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .gel-card__name {
    font-size: 1.3rem;
  }
  .gel-card__desc {
    color: var(--muted);
  }
  .gel-card__pick {
    align-self: start;
    margin-top: 4px;
    padding: 4px 12px;
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--ink);
    background: var(--tint);
    border-radius: 999px;
  }
  .gel-card__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 16px;
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .gel-card__meta strong {
    font-family: var(--display);
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--ink);
    white-space: nowrap;
  }

  /* 휴대폰(한 줄에 하나): 사진 왼쪽 · 글 오른쪽 가로 카드 */
  @media (max-width: 479px) {
    .gel-card--detailed {
      flex-direction: row;
    }
    .gel-card--detailed .gel-card__media {
      flex: 0 0 38%;
      border-right: var(--border);
      border-bottom: 0;
    }
    .gel-card--detailed .gel-card__media :global(img) {
      height: 100%;
      aspect-ratio: auto;
    }
    .gel-card--detailed .gel-card__badge {
      top: 10px;
      left: 10px;
      padding: 3px 8px;
      font-size: 0.625rem;
    }
    .gel-card--detailed .gel-card__body {
      padding: 16px;
    }
    .gel-card--detailed .gel-card__desc {
      font-size: var(--fs-sm);
    }
  }
  @media (max-width: 479px) {
    .gel-card:not(.gel-card--detailed) .gel-card__body {
      padding: 14px 14px 16px;
    }
    .gel-card:not(.gel-card--detailed) .gel-card__name {
      font-size: 1.05rem;
    }
    .gel-card:not(.gel-card--detailed) .gel-card__meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
    }
  }
</style>
