---
import PageHero from './PageHero.astro';
import GelCard from './GelCard.astro';
import LineCard from './LineCard.astro';
import DetailFold from './DetailFold.astro';
import CtaBand from './CtaBand.astro';
import Icon from '../ui/Icon.astro';
import Img from '../ui/Img.astro';
import SectionHead from '../ui/SectionHead.astro';
import { gelLineList, gelLines, noAdded, premiumIngredients } from '../../data/products';
import type { GelLineId } from '../../data/products';
import { url } from '../../lib/url';

/** 센슈얼·프리미엄·마사지 상세 페이지 본문 */
interface Props {
  line: GelLineId;
}

const line = gelLines[Astro.props.line];
const others = gelLineList.filter((l) => l.id !== line.id);
---

<PageHero
  eyebrow={`S-Solution · ${line.title}`}
  title={line.heroTitle}
  lead={line.description}
  tone={line.tone}
>
  <div class="page-hero__actions" slot="actions">
    <a class="btn btn--ink" href="#products">
      제품 보기 <Icon name="arrow-down" />
    </a>
    <a class="btn" href={url('gel.html')}>
      S-SOLUTION 전체
    </a>
  </div>
  <div
    class="shelf"
    slot="visual"
    aria-hidden="true"
    style={`--o: ${line.id === 'massage' ? 3 : 12}%`}
  >
    {line.products.map((p, i) => (
      <span class="shelf__item" style={`--i: ${i}; --n: ${line.products.length}`}>
        <Img name={p.image} alt="" width={600} loading="eager" />
      </span>
    ))}
  </div>
</PageHero>

<section class="section" id="products" aria-labelledby="products-title">
  <div class="container">
    <SectionHead
      eyebrow={line.title}
      id="products-title"
      title={`${line.ko} ${line.products.length}종`}
      lead={line.summary}
    />
    <ul class:list={['products', `products--${line.products.length}`]}>
      {line.products.map((p, i) => (
        <li data-reveal style={`--i: ${i}`}>
          <GelCard gel={p} detailed />
        </li>
      ))}
    </ul>
  </div>
</section>

{line.id === 'sensual' && (
  <section class="guide section" aria-labelledby="guide-title">
    <div class="container">
      <SectionHead
        eyebrow="Which One?"
        id="guide-title"
        title="어떤 젤이 나한테 맞을까요?"
        align="center"
      />
      <ol class="guide__list">
        {line.products.map((p, i) => (
          <li class="guide__row" data-reveal style={`--i: ${i}; --tint: ${p.tint}`}>
            <span class="guide__need">{p.pick}</span>
            <Icon name="arrow-right" class="guide__arrow" />
            <strong class="guide__pick">{p.name}</strong>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}

{line.id === 'premium' && (
  <section class="guide section" aria-labelledby="guide-title">
    <div class="container">
      <SectionHead
        eyebrow="Ingredients"
        id="guide-title"
        title="좋은 성분을<br />꾹 눌러 담았어요."
        lead="클라이막스 솔루션에 들어간 주요 성분이에요. 펌프 방식이라 위생적으로 쓸 수 있어요."
        align="center"
      />
      <ul class="ingredients">
        {premiumIngredients.map((ing, i) => (
          <li data-reveal style={`--i: ${i}`}>
            <strong>{ing.name}</strong>
            <span>{ing.note}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

{line.id === 'massage' && (
  <section class="guide section" aria-labelledby="guide-title">
    <div class="container">
      <SectionHead
        eyebrow="6 No Added"
        id="guide-title"
        title="여섯 가지는<br />처음부터 넣지 않았어요."
        lead="피부에 부담될 수 있는 성분을 뺀 안심 처방. 수분 공급과 보습은 그대로예요."
        align="center"
      />
      <ul class="no-added">
        {noAdded.map((name, i) => (
          <li data-reveal style={`--i: ${i}`}>
            <span class="no-added__mark" aria-hidden="true">
              NO
            </span>
            {name}
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<section class="details section" aria-labelledby="details-title">
  <div class="container">
    <SectionHead
      eyebrow="Details"
      id="details-title"
      title="상세 정보"
      lead="원본 상세 페이지를 그대로 담았어요."
      align="center"
    />
    <div class="details__fold">
      <DetailFold id={`detail-${line.id}`} images={line.details} />
    </div>
  </div>
</section>

<section class="others section" aria-labelledby="others-title">
  <div class="container">
    <SectionHead eyebrow="More S-Solution" id="others-title" title="다른 라인도 둘러보세요." />
    <ul class="others__grid">
      {others.map((l, i) => (
        <li data-reveal style={`--i: ${i}`}>
          <LineCard line={l} />
        </li>
      ))}
    </ul>
  </div>
</section>

<CtaBand
  title="마음에 드는 젤,<br />공식몰에서 만나요."
  text="S-SOLUTION 러브젤과 마사지젤은 부르르닷컴에서 구매할 수 있어요."
/>

<style>
  .shelf {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: min(100%, 520px);
    aspect-ratio: 5 / 4;
    padding-bottom: 5%;
    overflow: hidden;
    /* 제품 사진의 흰 배경이 이 그라데이션에 섞여(multiply) 조명을 받은 진열대처럼 보입니다. */
    background: radial-gradient(
      ellipse 70% 55% at 50% 78%,
      var(--white) 0 45%,
      color-mix(in srgb, var(--tone) 70%, var(--white)) 100%
    );
    border: var(--border);
    border-radius: 999px 999px var(--radius-lg) var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }
  /* 사진끼리 --o 만큼 겹쳐 놓아도 전체 폭은 항상 100%입니다. */
  .shelf__item {
    width: calc(100% / var(--n) + var(--o) * 2);
    margin-inline: calc(var(--o) * -1);
    animation: shelf-in 0.9s var(--ease-spring) both;
    animation-delay: calc(var(--i) * 110ms + 100ms);
  }
  .shelf__item :global(img) {
    width: 100%;
    mix-blend-mode: multiply;
  }
  @keyframes shelf-in {
    from {
      opacity: 0;
      transform: translateY(60px);
    }
  }

  .products {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin-top: clamp(40px, 5vw, 64px);
  }
  .products--3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .guide {
    background: var(--cream);
  }
  .guide__list {
    display: grid;
    gap: 12px;
    max-width: 860px;
    margin: clamp(36px, 5vw, 56px) auto 0;
  }
  .guide__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(120px, auto);
    align-items: center;
    gap: 16px;
    padding: 18px 24px;
    background: var(--white);
    border: var(--border);
    border-radius: 999px;
  }
  .guide__need {
    font-weight: 600;
  }
  .guide__pick {
    justify-self: end;
    padding: 6px 16px;
    color: var(--ink);
    background: var(--tint);
    border-radius: 999px;
  }

  .ingredients {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-top: clamp(36px, 5vw, 56px);
  }
  .ingredients li {
    display: grid;
    gap: 6px;
    place-content: center;
    min-height: 160px;
    padding: 24px;
    text-align: center;
    background: var(--white);
    border: var(--border);
    border-radius: 50%;
    aspect-ratio: 1;
  }
  .ingredients strong {
    font-size: 1.125rem;
    color: var(--ink);
  }
  .ingredients span {
    font-size: var(--fs-sm);
    color: var(--muted);
  }

  .no-added {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 14px;
    margin-top: clamp(36px, 5vw, 56px);
  }
  .no-added li {
    display: grid;
    justify-items: center;
    gap: 12px;
    padding: 22px 10px;
    font-weight: 700;
    color: var(--ink);
    text-align: center;
    background: var(--white);
    border: var(--border);
    border-radius: var(--radius);
  }
  .no-added__mark {
    position: relative;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    font-family: var(--display);
    font-size: 0.8125rem;
    font-weight: 800;
    color: #d93a3a;
    border: 3px solid #d93a3a;
    border-radius: 50%;
  }
  .no-added__mark::after {
    content: '';
    position: absolute;
    width: 3px;
    height: 60px;
    background: #d93a3a;
    rotate: 45deg;
  }

  .details__fold {
    margin-top: clamp(32px, 4vw, 48px);
  }

  .others {
    padding-top: 0;
  }
  .others__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: clamp(32px, 4vw, 48px);
  }

  @media (max-width: 1023px) {
    .products,
    .products--3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .ingredients {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: 520px;
      margin-inline: auto;
    }
    .no-added {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 767px) {
    .others__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .guide__row {
      grid-template-columns: minmax(0, 1fr) auto;
      border-radius: var(--radius);
    }
    .guide__row :global(.guide__arrow) {
      display: none;
    }
  }
  @media (max-width: 479px) {
    .products,
    .products--3 {
      grid-template-columns: minmax(0, 1fr);
    }
    .no-added {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
