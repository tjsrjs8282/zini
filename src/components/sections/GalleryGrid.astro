---
import 'photoswipe/style.css';
import { getImage, Image } from 'astro:assets';
import type { GallerySection } from '../../data/gallery';
import { img } from '../../lib/images';

interface Props {
  section: GallerySection;
}

const { section } = Astro.props;
const columns = section.colClass.includes('col-md-3') ? 4 : 3;
const items = await Promise.all(
  section.images.map(async (name) => {
    const meta = img(name);
    const large = await getImage({ src: meta, width: Math.min(meta.width, 1600), format: 'webp' });
    return { meta, large };
  }),
);
---

<section
  class="gallery-section mb-5 bg-white shadow-card"
  id={section.id}
  aria-labelledby={`${section.id}-title`}
>
  <div class="product pt-5 text-center">
    <h2 id={`${section.id}-title`}>{section.title}</h2>
    {section.years && <p>{section.years}</p>}
  </div>
  <div class="container-fluid">
    <div class="row g-0" data-gallery>
      {items.map((item, i) => (
        <div class={section.colClass}>
          <a
            class="img-wrapper"
            href={item.large.src}
            data-pswp-width={item.large.attributes.width}
            data-pswp-height={item.large.attributes.height}
          >
            <Image
              src={item.meta}
              alt={`${section.title} 사진 ${i + 1}`}
              widths={[300, 480, 720]}
              sizes={`(min-width: 768px) ${Math.round(100 / columns)}vw, 50vw`}
            />
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const lightbox = new PhotoSwipeLightbox({
      gallery,
      children: 'a',
      pswpModule: () => import('photoswipe'),
      bgOpacity: 0.9,
      closeTitle: '닫기 (Esc)',
      zoomTitle: '확대/축소 (Z)',
      arrowPrevTitle: '이전 사진',
      arrowNextTitle: '다음 사진',
      errorMsg: '사진을 불러오지 못했습니다.',
    });
    lightbox.init();
  });
</script>

<style>
  .img-wrapper {
    display: block;
    overflow: hidden;
  }
  .img-wrapper img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.5s ease;
    cursor: zoom-in;
  }
  .img-wrapper:hover img,
  .img-wrapper:focus-visible img {
    transform: scale(1.3);
  }
</style>
