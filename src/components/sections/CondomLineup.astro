---
import ProductCard from './ProductCard.astro';
import Zigzag from '../ui/Zigzag.astro';
import { linePages, products } from '../../data/products';

interface Props {
  /** 콘돔 상세 페이지로 연결할지 여부(콘돔 페이지 자신에서는 false) */
  linked?: boolean;
}

const { linked = true } = Astro.props;
---

<section class="band bg-white mb-5 condom-lineup">
  <div class="container text-center shadow-card">
    <div class="row">
      <div class="col-12 mt-2 product">
        <h2>ZINI CONDOMS</h2>
        <p>CONDOMS LINE UP</p>
      </div>
      {products.condom.map((p) => (
        <ProductCard
          class="col-12 col-md-4"
          product={p}
          href={linked ? linePages.condom : undefined}
          variant="condom"
        />
      ))}
    </div>
  </div>
  <Zigzag edge="bottom" point="up" inset />
</section>

<style>
  .condom-lineup {
    position: relative;
  }
</style>
