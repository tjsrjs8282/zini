---
import { Image } from 'astro:assets';
import { img } from '../../lib/images';
import { url } from '../../lib/url';

// 사업분야 이미지(999×822) 속 원의 위치. 링크를 백분율로 배치해 이미지 크기에 맞춰 함께 줄어듭니다.
const IMAGE_W = 999;
const IMAGE_H = 822;
const areas = [
  {
    x: 500,
    y: 111,
    r: 112,
    label: '자체 성인용품 브랜드 제조 — ZINI',
    href: 'https://www.zini.com/',
  },
  {
    x: 791,
    y: 237,
    r: 114,
    label: '자체 러브 코스메틱 브랜드 제조 — S-SOLUTION',
    href: 'gel.html',
  },
  {
    x: 776,
    y: 503,
    r: 111,
    label: '성인용품 온라인 스토어 — 부르르닷컴',
    href: 'https://www.bururu.com/',
  },
  { x: 626, y: 706, r: 113, label: '성인용품 수입/통관 대행', href: 'about.html' },
  { x: 377, y: 704, r: 110, label: '성인용품 OEM/ODM', href: 'about.html' },
  { x: 212, y: 502, r: 111, label: '성인용품 창업컨설팅', href: 'about.html' },
  {
    x: 212,
    y: 236,
    r: 112,
    label: '성인용품 도/소매 유통 — 엠에스하모니',
    href: 'https://www.mshb2b.com/',
  },
].map((a) => ({
  ...a,
  style: [
    `left: ${(((a.x - a.r) / IMAGE_W) * 100).toFixed(2)}%`,
    `top: ${(((a.y - a.r) / IMAGE_H) * 100).toFixed(2)}%`,
    `width: ${(((a.r * 2) / IMAGE_W) * 100).toFixed(2)}%`,
  ].join('; '),
}));
---

<section class="brands" aria-labelledby="brands-title">
  <h2 id="brands-title" class="visually-hidden">
    사업분야
  </h2>
  <div class="container text-center d-none d-md-block">
    <div class="brand-map my-5">
      <Image
        src={img('business.png')}
        alt="케어앤셰어 사업분야: 제조, 유통, 온라인 스토어, 수입 대행, OEM/ODM, 창업컨설팅"
        widths={[700, 999]}
        sizes="(min-width: 1200px) 999px, 90vw"
      />
      {areas.map((a) => (
        <a
          class="brand-area"
          href={url(a.href)}
          style={a.style}
          aria-label={a.label}
          title={a.label}
          {...(a.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        />
      ))}
    </div>
  </div>
</section>

<style>
  .brands {
    background-color: var(--c-dark);
  }
  .brand-map {
    position: relative;
    display: inline-block;
    max-width: 100%;
  }
  .brand-map img {
    display: block;
    max-width: 100%;
    height: auto;
  }
  .brand-area {
    position: absolute;
    aspect-ratio: 1;
    border-radius: 50%;
  }
  .brand-area:hover,
  .brand-area:focus-visible {
    box-shadow: 0 0 0 4px rgba(32, 201, 196, 0.6);
  }
</style>
