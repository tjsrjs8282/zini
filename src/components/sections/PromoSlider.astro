---
import 'swiper/css';
import 'swiper/css/effect-fade';
import 'swiper/css/pagination';
import { getImage } from 'astro:assets';
import { promoSlides } from '../../data/banners';
import { img } from '../../lib/images';
import { url } from '../../lib/url';

// PC·모바일용 이미지를 따로 쓰는 아트 디렉션 배너(<picture>)
const slides = await Promise.all(
  promoSlides.map(async (slide) => {
    const [desktop, mobile, fallback] = await Promise.all([
      getImage({ src: img(slide.desktop), widths: [960, 1440, 1920, 2560], format: 'webp' }),
      getImage({ src: img(slide.mobile), widths: [480, 768, 1200], format: 'webp' }),
      getImage({ src: img(slide.desktop), width: 1920, format: 'jpg' }),
    ]);
    return { ...slide, desktop, mobile, fallback };
  }),
);
---

<section class="promo" aria-label="프로모션 배너">
  <div class="swiper" data-promo-swiper>
    <div class="swiper-wrapper">
      {slides.map((slide) => (
        <div class="swiper-slide">
          <picture>
            <source
              media="(max-width: 950px)"
              srcset={slide.mobile.srcSet.attribute}
              sizes="100vw"
              type="image/webp"
              width={slide.mobile.attributes.width}
              height={slide.mobile.attributes.height}
            />
            <source srcset={slide.desktop.srcSet.attribute} sizes="100vw" type="image/webp" />
            <img
              class="promo-img"
              src={slide.fallback.src}
              width={slide.fallback.attributes.width}
              height={slide.fallback.attributes.height}
              alt={slide.alt}
              loading="lazy"
              decoding="async"
            />
          </picture>
          <div class:list={['col-8', 'text-box', { 'text-white': slide.light }]}>
            <p class="kicker">{slide.kicker}</p>
            <p class="title">
              {slide.title}
              <span>{slide.titleSub}</span>
            </p>
            <a
              href={url(slide.href)}
              class="btn-pill"
              {...(slide.href.startsWith('http')
                ? { target: '_blank', rel: 'noopener noreferrer' }
                : {})}
            >
              더 보기
            </a>
          </div>
        </div>
      ))}
    </div>
    <div class="swiper-pagination pager-squares"></div>
  </div>
</section>

<script>
  import { Autoplay, EffectFade, Pagination } from 'swiper/modules';
  import { createSwiper } from '../../scripts/swiper';

  document.querySelectorAll<HTMLElement>('[data-promo-swiper]').forEach((el) => {
    createSwiper(el, {
      modules: [EffectFade, Autoplay, Pagination],
      effect: 'fade',
      fadeEffect: { crossFade: true },
      loop: true,
      speed: 800,
      autoplay: { delay: 4000, disableOnInteraction: false, pauseOnMouseEnter: true },
      pagination: { el: el.querySelector<HTMLElement>('.swiper-pagination'), clickable: true },
    });
  });
</script>

<style>
  .promo .swiper {
    --swiper-pagination-bottom: 10px;
  }
  .promo-img {
    display: block;
    width: 100%;
    height: auto;
  }
  .text-box {
    position: absolute;
    top: 50%;
    left: 80%;
    transform: translate(-50%, -50%);
  }
  .kicker {
    margin-bottom: 0.5rem;
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--c-text);
  }
  .title {
    margin-bottom: 0.5rem;
    font-size: 2.4rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--c-text);
  }
  .text-white .kicker,
  .text-white .title {
    color: #fff;
  }
  @media (max-width: 767px) {
    .title {
      font-size: 2rem;
    }
  }
  @media (max-width: 550px) {
    .title {
      font-size: 1.5rem;
    }
    .kicker {
      font-size: 1.2rem;
    }
  }
  @media (max-width: 450px) {
    .title {
      font-size: 1.2rem;
    }
    .kicker {
      font-size: 1rem;
    }
  }
</style>
