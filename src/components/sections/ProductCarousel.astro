---
import 'swiper/css';
import 'swiper/css/navigation';
import 'swiper/css/pagination';
import { getImage, Image } from 'astro:assets';
import { carouselItems } from '../../data/products';
import { img } from '../../lib/images';

const background = await getImage({ src: img('banana.jpg'), format: 'webp' });

const arrowPath = {
  next: [
    'M4.31,6.484c-1.604,0-2.904,1.741-2.904,3.892v1.084v29.048v1.085c0,2.15,1.301,3.891,2.904,3.891c1.602,0,2.902-1.74,2.902-3.891V39.64V12.33v-1.954C7.212,8.226,5.912,6.484,4.31,6.484z',
    'M94.525,23.256c-0.939-5.449-6.208-9.945-11.168-12.021L7.445,11.236v29.497h75.913c4.96-2.075,10.229-6.572,11.168-12.021c2.125-0.003,3.847-1.225,3.847-2.729C98.372,24.479,96.65,23.257,94.525,23.256z',
  ],
  prev: [
    'M95.469,45.482c1.604,0,2.904-1.741,2.904-3.892v-1.084V11.458v-1.085c0-2.15-1.301-3.891-2.904-3.891c-1.602,0-2.902,1.74-2.902,3.891v1.953v27.31v1.954C92.566,43.741,93.867,45.482,95.469,45.482z',
    'M5.254,28.711c0.939,5.449,6.208,9.945,11.168,12.021l75.912-0.001V11.233H16.422c-4.96,2.075-10.229,6.572-11.168,12.021c-2.125,0.003-3.847,1.225-3.847,2.729C1.407,27.487,3.129,28.71,5.254,28.711z',
  ],
};
---

<section class="band mb-5 product-carousel" style={`--carousel-bg: url(${background.src})`}>
  <div class="container text-center">
    <div class="row">
      <div class="col-12 product mb-3">
        <h2>ZINI CONDOMS</h2>
      </div>
    </div>
    <div class="carousel-area">
      <div class="swiper" data-product-swiper>
        <div class="swiper-wrapper">
          {carouselItems.map((item) => (
            <div class="swiper-slide">
              <Image src={img(item.image)} alt={item.alt} width={200} densities={[1, 2]} />
            </div>
          ))}
        </div>
        <div class="swiper-pagination pager-squares"></div>
      </div>
      {(['next', 'prev'] as const).map((dir) => (
        <button
          type="button"
          class={`slider-btn slider-btn--${dir}`}
          aria-label={dir === 'next' ? '다음 상품' : '이전 상품'}
        >
          <svg width="100" height="50" viewBox="0 0 100 50" aria-hidden="true" focusable="false">
            {arrowPath[dir].map((d) => (
              <path d={d} />
            ))}
            <text x="29" y="32.13">
              {dir.toUpperCase()}
            </text>
          </svg>
        </button>
      ))}
    </div>
  </div>
</section>

<script>
  import { Autoplay, Navigation, Pagination } from 'swiper/modules';
  import { createSwiper } from '../../scripts/swiper';

  document.querySelectorAll<HTMLElement>('[data-product-swiper]').forEach((el) => {
    const area = el.closest<HTMLElement>('.carousel-area');
    createSwiper(el, {
      modules: [Autoplay, Navigation, Pagination],
      slidesPerView: 3,
      spaceBetween: 16,
      breakpoints: { 576: { spaceBetween: 30 }, 768: { spaceBetween: 55 } },
      loop: true,
      speed: 600,
      autoplay: { delay: 4000, disableOnInteraction: false, pauseOnMouseEnter: true },
      navigation: {
        nextEl: area?.querySelector<HTMLElement>('.slider-btn--next'),
        prevEl: area?.querySelector<HTMLElement>('.slider-btn--prev'),
      },
      pagination: { el: el.querySelector<HTMLElement>('.swiper-pagination'), clickable: true },
    });
  });
</script>

<style>
  .product-carousel {
    position: relative;
    z-index: 1;
    height: 500px;
    background: var(--carousel-bg) center / cover no-repeat;
  }
  .carousel-area {
    position: relative;
    float: right;
    width: 66.666667%;
  }
  .swiper {
    --swiper-pagination-bottom: 0;
    max-width: 710px;
    padding-bottom: 61px;
  }
  .swiper img {
    display: block;
    width: 100%;
    max-width: 200px;
    height: auto;
    margin: 0 auto;
  }

  .slider-btn {
    position: absolute;
    bottom: 100px;
    z-index: 10;
  }
  .slider-btn--next {
    right: -70px;
  }
  .slider-btn--prev {
    left: -70px;
  }
  .slider-btn path {
    fill: none;
    stroke: #424243;
    stroke-miterlimit: 10;
  }
  .slider-btn text {
    font-size: 17px;
    font-weight: 700;
    fill: #59595a;
  }
  .slider-btn:hover path {
    stroke: #000;
  }
  .slider-btn:hover text {
    fill: #000;
  }

  @media (max-width: 1100px) {
    .slider-btn {
      bottom: -80px;
    }
    .slider-btn--next {
      right: 0;
    }
    .slider-btn--prev {
      left: 0;
    }
  }
  @media (max-width: 767px) {
    .carousel-area {
      float: none;
      width: 100%;
    }
  }
</style>
