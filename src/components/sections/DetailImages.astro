---
import { Image } from 'astro:assets';
import { img } from '../../lib/images';

/** 젤 상세 페이지 상단의 긴 상품 설명 이미지 묶음 */
interface Props {
  title: string;
  images: { src: string; alt: string; half?: boolean }[];
  /** 프리미엄 페이지처럼 사진 주위에 여백을 줍니다. */
  padded?: boolean;
}

const { title, images, padded = false } = Astro.props;
---

<section class="band bg-white mb-5">
  <div class:list={['container', 'text-center', 'shadow-card', { 'p-5': padded }]}>
    <div class="row">
      <div class:list={['col-12', 'product', padded ? 'pt-3' : 'pt-5']}>
        <h2>{title}</h2>
      </div>
      {images.map((image) => (
        <div class:list={[image.half ? 'col-6' : 'col-12', 'product', { 'p-4': padded }]}>
          <Image
            class="w-100 h-auto"
            src={img(image.src)}
            alt={image.alt}
            widths={image.half ? [350, 600] : [500, 750, 1000]}
            sizes={
              image.half ? '(min-width: 1200px) 555px, 50vw' : '(min-width: 1200px) 1110px, 100vw'
            }
          />
        </div>
      ))}
    </div>
  </div>
</section>
