---
// 아이콘 폰트(Font Awesome 4, Themify) 대신 인라인 SVG를 씁니다.
// 브랜드 아이콘: Simple Icons(CC0) / 전화 아이콘: Material Design Icons(Apache-2.0)
import { siFacebook, siInstagram, siX, siYoutube } from 'simple-icons';

const brand = { facebook: siFacebook, x: siX, youtube: siYoutube, instagram: siInstagram };

const ui = {
  'chevron-left':
    '<path d="M15 18l-6-6 6-6" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>',
  'chevron-right':
    '<path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>',
  phone:
    '<rect width="24" height="24" rx="4" fill="currentColor"/><path fill="var(--icon-cutout, #fff)" transform="translate(4.5 4.5) scale(0.625)" d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>',
};

export type IconName = keyof typeof brand | keyof typeof ui;

interface Props {
  name: IconName;
  size?: number | string;
  class?: string;
}

const { name, size = '1em', class: className } = Astro.props;
const body =
  name in brand
    ? `<path fill="currentColor" d="${brand[name as keyof typeof brand].path}"/>`
    : ui[name as keyof typeof ui];
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  set:html={body}
/>

<style>
  .icon {
    display: inline-block;
    vertical-align: middle;
    flex-shrink: 0;
  }
</style>
