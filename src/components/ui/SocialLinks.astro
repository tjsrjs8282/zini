---
import Icon from './Icon.astro';
import { socialLinks } from '../../data/site';

/** 소셜 링크 — light: 밝은 배경 / dark: 어두운 배경 */
interface Props {
  tone?: 'light' | 'dark';
  class?: string;
}

const { tone = 'light', class: className } = Astro.props;
---

<ul class:list={['social', `social--${tone}`, className]}>
  {socialLinks.map((s) => (
    <li>
      <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={`${s.label} (새 창)`}>
        <Icon name={s.id} size="18" />
      </a>
    </li>
  ))}
</ul>

<style>
  .social {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .social a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    transition:
      transform 0.25s var(--ease-spring),
      background-color 0.2s,
      color 0.2s;
  }
  .social a:hover {
    transform: translateY(-3px) rotate(-6deg);
  }
  .social--light a {
    color: var(--ink);
    background: var(--white);
    border: var(--border);
  }
  .social--light a:hover {
    background: var(--yellow);
  }
  .social--dark a {
    color: var(--white);
    border: 1.5px solid rgb(255 255 255 / 30%);
  }
  .social--dark a:hover {
    color: var(--ink);
    background: var(--yellow);
    border-color: var(--yellow);
  }
</style>
