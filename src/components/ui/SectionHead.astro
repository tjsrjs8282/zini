---
/**
 * 섹션 머리말(영문 eyebrow + 제목 + 설명). 제목·설명에는 <br />을 쓸 수 있습니다.
 * 스타일은 global.css의 .section-head 에 있습니다.
 */
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'start' | 'center';
  as?: 'h1' | 'h2';
  id?: string;
  class?: string;
}

const { eyebrow, title, lead, align = 'start', as: Tag = 'h2', id, class: className } = Astro.props;
---

<div class:list={['section-head', `section-head--${align}`, className]} data-reveal>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Tag class="section-title" id={id} set:html={title} />
  {lead && <p class="section-lead" set:html={lead} />}
  <slot />
</div>
