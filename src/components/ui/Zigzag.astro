---
/**
 * 콘돔 포장지처럼 톱니 모양으로 끝나는 섹션 가장자리. 부모는 position: relative 여야 합니다.
 * - edge: 섹션의 어느 쪽에 붙일지(톱니가 바깥쪽 이웃 섹션 위로 튀어나옵니다)
 * - color: 섹션 배경과 같은 색
 */
interface Props {
  edge?: 'top' | 'bottom';
  color?: string;
  class?: string;
}

const { edge = 'bottom', color, class: className } = Astro.props;
---

<span
  class:list={['zigzag', `zigzag--${edge}`, className]}
  style={color ? `--zz: ${color}` : undefined}
  aria-hidden="true"
></span>
