---
/**
 * 섹션 가장자리의 톱니(지그재그) 장식. 부모 요소는 position: relative 여야 합니다.
 * - edge: 붙일 가장자리 / point: 삼각형 방향
 * - inset: true면 섹션 안쪽, false면 바깥쪽(10px 밖)에 붙습니다.
 */
interface Props {
  edge: 'top' | 'bottom';
  point: 'up' | 'down';
  color?: string;
  inset?: boolean;
  class?: string;
}

const { edge, point, color, inset = false, class: className } = Astro.props;
const style = [`${edge}: ${inset ? '0' : '-10px'}`, color && `--zigzag-color: ${color}`]
  .filter(Boolean)
  .join('; ');
---

<span
  class:list={['zigzag', `zigzag--${point}`, className]}
  style={style}
  aria-hidden="true"
></span>
