---
import '../styles/global.css';

import { Font, getImage } from 'astro:assets';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { site } from '../data/site';
import type { NavId } from '../data/site';
import { img } from '../lib/images';
import { url } from '../lib/url';

interface Props {
  /** 페이지 제목(브라우저 탭·검색 결과). 비우면 사이트 기본 제목을 씁니다. */
  title?: string;
  description?: string;
  /** 현재 메뉴 강조 */
  current: NavId;
  /** 첫 화면 배경색 — 모바일 브라우저 주소창 색(theme-color)에 씁니다. */
  themeColor?: string;
}

const { title, description = site.description, current, themeColor = '#ffd504' } = Astro.props;

const pageTitle = title ? `${title} | ZINI 지니` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = await getImage({ src: img('ex01.jpg'), width: 1200, format: 'jpg' });
const ogImageUrl = new URL(ogImage.src, Astro.site);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('favicon.ico')} sizes="32x32" />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <meta name="theme-color" content={themeColor} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ZINI 지니" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImage.attributes.width)} />
    <meta property="og:image:height" content={String(ogImage.attributes.height)} />
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-display" preload />
    <script is:inline>
      document.documentElement.classList.add('js');
      // 페이지 전환 효과가 생략되면(백그라운드 탭 등) 브라우저가 내는 오류를 조용히 처리합니다.
      ['pageswap', 'pagereveal'].forEach((type) =>
        addEventListener(type, (e) => e.viewTransition?.ready.catch(() => {})),
      );
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      본문 바로가기
    </a>
    <Header current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
