---
import '@fontsource-variable/noto-sans-kr';
import 'bootstrap/dist/css/bootstrap-reboot.min.css';
import 'bootstrap/dist/css/bootstrap-grid.min.css';
import 'bootstrap/dist/css/bootstrap-utilities.min.css';
import '../styles/global.css';

import { getImage } from 'astro:assets';
import Header from '../components/layout/Header.astro';
import FullNav from '../components/layout/FullNav.astro';
import Footer from '../components/layout/Footer.astro';
import { site } from '../data/site';
import type { NavId } from '../data/site';
import { img } from '../lib/images';
import { url } from '../lib/url';

interface Props {
  /** 페이지 제목(브라우저 탭·검색 결과). 비우면 사이트 기본 제목을 씁니다. */
  title?: string;
  description?: string;
  /** 현재 메뉴 강조 */
  current: NavId;
  /** 페이지 배경 테마 */
  theme?: 'default' | 'white' | 'dark';
  footer?: boolean;
}

const {
  title,
  description = site.description,
  current,
  theme = 'default',
  footer = true,
} = Astro.props;

const pageTitle = title ? `${title} | ZINI 지니` : 'ZINI 지니 | 캐릭터 콘돔 & 러브젤 브랜드';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = await getImage({ src: img('ex01.jpg'), width: 1200, format: 'jpg' });
const ogImageUrl = new URL(ogImage.src, Astro.site);
---

<!doctype html>
<html lang="ko" class:list={[`theme-${theme}`]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.ico')} sizes="any" />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <meta name="theme-color" content="#fdb813" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ZINI 지니" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImage.attributes.width)} />
    <meta property="og:image:height" content={String(ogImage.attributes.height)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      본문 바로가기
    </a>
    <Header current={current}>
      <slot name="hero" />
    </Header>
    <FullNav current={current} />
    <main id="main">
      <slot />
    </main>
    {footer && <Footer />}
  </body>
</html>

<style is:global>
  .theme-white body {
    background-color: #fff;
  }
  html.theme-dark,
  .theme-dark body {
    background-color: var(--c-dark);
  }
</style>
